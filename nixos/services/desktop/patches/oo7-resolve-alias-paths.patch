+    async fn resolve_alias_path(
+        collections: &HashMap<OwnedObjectPath, Collection>,
+        path: &ObjectPath<'_>,
+    ) -> Option<OwnedObjectPath> {
+        let alias = path
+            .as_str()
+            .strip_prefix("/org/freedesktop/secrets/aliases/")?;
+        let alias_to_find = if alias == Self::LOGIN_ALIAS {
+            oo7::dbus::Service::DEFAULT_COLLECTION
+        } else {
+            alias
+        };
+        for (col_path, collection) in collections.iter() {
+            if collection.alias().await == alias_to_find {
+                return Some(col_path.clone());
+            }
+        }
+        None
+    }
