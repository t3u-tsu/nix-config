#!/usr/bin/env ysh
#
# Build the ConoHa VPS installer ISO with an auto-issued temporary password
# (hash baked in via TORII_INSTALLER_TEMP_PASSWORD_HASH in an --impure build;
# plaintext in result-iso-temp-password.txt, mode 0600).
# Reproducible build without a password (SSH key only):
#   nix build .#torii-chan-vps-iso -o result-iso

source $_this_dir/../../scripts/lib/common.ysh

proc main(; argv) {
  cd $_this_dir/../.. {
    if (not command_exists('openssl')) {
      die 'openssl is required to issue the temporary password'
    }

    var temp_password = issue_temp_password()
    var password_hash = sha512_crypt_hash(temp_password)

    echo '==> Starting ISO build (--impure)...'
    TORII_INSTALLER_TEMP_PASSWORD_HASH=$password_hash \
      nix build --impure .#torii-chan-vps-iso -o result-iso

    var password_file = 'result-iso-temp-password.txt'
    umask 077
    printf 'Temporary password (for root / t3u in the live environment): %s\n' $temp_password > $password_file
    printf 'Keep this file safe even after the ISO build completes, and delete it once no longer needed.\n' >> $password_file

    echo '==> Build complete'
    ls -lh result-iso/iso/
    echo $"Temporary password saved to: ${password_file}"
  }
}

if is-main { main (ARGV) }
