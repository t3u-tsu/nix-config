#!/usr/bin/env ysh
#
# The node private keys live in secrets/hosts/<host>.yaml, which deliberately
# excludes the user key: run this with the operator's master key
# (SOPS_AGE_KEY_FILE), or on each host with its own SSH host key.
#
# Usage:
#   SOPS_AGE_KEY_FILE=/path/to/master-age-key.txt \
#     ysh scripts/nebula-import-secrets.ysh [CA_DIR]
#
# CA_DIR defaults to ~/.nebula-ca. The node list comes from
# scripts/nebula-lib.ysh (FLEET); safe to re-run after a rotation.

source $_this_dir/nebula-lib.ysh

func file_exists(path) {
  try { test -f $path }
  return (_error.code === 0)
}

# Expected decrypt failures shouldn't log caught errexit.
shopt --unset verbose_errexit

var ca_dir = ENV.HOME ++ '/.nebula-ca'
if (len(ARGV) >= 1) {
  setvar ca_dir = ARGV[0]
}

cd $_this_dir/..

if (file_exists($"${ca_dir}/ca.crt")) {
  var ca_json = ''
  read --all (&ca_json) < $"${ca_dir}/ca.crt"
  sops set secrets/common.yaml '["nebula_ca"]' $(json write (ca_json))
  echo "OK: nebula_ca -> secrets/common.yaml"
} else {
  echo $"SKIP: ${ca_dir}/ca.crt not found" >&2
}

for node in (FLEET) {
  var name = node.name
  var file = host_secrets_file(name)
  var prefix = host_key(name)
  var crt = $"${ca_dir}/${name}.crt"
  var key = $"${ca_dir}/${name}.key"

  if (file_exists(crt) and file_exists(key)) {
    var cert_json = ''
    var key_json = ''
    read --all (&cert_json) < $crt
    read --all (&key_json) < $key

    var cert_path = '["' ++ prefix ++ '_nebula_cert"]'
    var key_path = '["' ++ prefix ++ '_nebula_key"]'
    sops set $file $cert_path $(json write (cert_json))
    sops set $file $key_path $(json write (key_json))
    echo $"OK: ${prefix}_nebula_cert / ${prefix}_nebula_key -> $file"
  } else {
    echo $"SKIP: ${ca_dir}/${name}.crt or ${ca_dir}/${name}.key not found" >&2
  }
}

echo
echo "All Nebula secrets imported. Verifying..."
var verify_failed = 0
for node in (FLEET) {
  var file = host_secrets_file(node.name)
  var prefix = host_key(node.name)
  var decrypted = ''
  try {
    setvar decrypted = $(sops --decrypt $file 2>/dev/null)
  }
  if failed {
    echo $"  SKIP verify: ${file} (no decryption key available)" >&2
  } elif (decrypted.contains($"${prefix}_nebula_cert")) {
    echo $"  OK: ${file} (${prefix}_nebula_cert)"
  } else {
    echo $"  MISSING: ${file} (${prefix}_nebula_cert)" >&2
    setvar verify_failed = 1
  }
}
exit $verify_failed
