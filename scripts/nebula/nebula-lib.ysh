#!/usr/bin/env ysh
#
# Shared Nebula mesh helpers. Loads the node fleet from lib/nebula-fleet.nix.

var FLEET = []
var DEFAULT_PREFIX = '10.0.0'

func file_exists(path) {
  try { test -f $path }
  return (_error.code === 0)
}

func command_exists(name) {
  try { command -v $name >/dev/null 2>&1 }
  return (_error.code === 0)
}

func default_ca_dir() {
  var home = get(ENV, 'HOME', '')
  if (home === '') {
    return ('')
  }
  return ($"${home}/.nebula-ca")
}

func load_fleet_from_nix() {
  var root_dir = _this_dir ++ '/../..'
  var nix_file = root_dir ++ '/lib/nebula-fleet.nix'
  if (not file_exists(nix_file)) {
    return (false)
  }
  var json_str = ''
  try { setvar json_str = $(nix eval --json --impure --expr "import ${nix_file}") }
  if (_error.code !== 0 or json_str === '') {
    return (false)
  }
  var parsed = null
  try { json read (&parsed) <<< $json_str }
  if (_error.code !== 0 or parsed === null) {
    return (false)
  }
  if (parsed.prefix !== null) {
    setglobal DEFAULT_PREFIX = parsed.prefix
  }
  if (parsed.fleet !== null) {
    setglobal FLEET = parsed.fleet
  }
  return (true)
}

if (not load_fleet_from_nix()) {
  echo 'ERROR: failed to load nebula fleet from lib/nebula-fleet.nix' >&2
  exit 1
}
