#!/usr/bin/env ysh
#
# Imports the Nebula PKI generated by scripts/nebula/nebula-rotate-ca.ysh: ca.crt is
# published to nixos/networking/nebula/ca.crt, each node cert to
# hosts/<name>/nebula.crt, and each node private key is encrypted to
# secrets/master/hosts/<name>/nebula_key.age with the Bitwarden master identity.
#
# Usage:
#   ysh scripts/nebula/nebula-import-secrets.ysh [CA_DIR]
#
# CA_DIR defaults to ~/.nebula-ca, the same default as
# scripts/nebula/nebula-rotate-ca.ysh. The node list comes from scripts/nebula/nebula-lib.ysh
# (FLEET); safe to re-run after a rotation.

source $_this_dir/../secrets/agenix-bw-lib.ysh
source $_this_dir/nebula-lib.ysh

agenix_bw_swap_guard $0 @[ARGV]

shopt --unset verbose_errexit

proc usage() {
  echo 'usage: ysh scripts/nebula/nebula-import-secrets.ysh [CA_DIR]'
}

if (len(ARGV) > 1) {
  usage
  exit 2
}
if (len(ARGV) === 1 and (ARGV[0] === '-h' or ARGV[0] === '--help')) {
  usage
  exit 0
}

var ca_dir = ''
if (len(ARGV) === 1) {
  setvar ca_dir = ARGV[0]
} else {
  setvar ca_dir = default_ca_dir()
  if (ca_dir === '') {
    echo 'ERROR: HOME is unset; pass CA_DIR explicitly.' >&2
    exit 2
  }
}

try { test -d $ca_dir }
if failed {
  echo $"ERROR: CA directory not found: ${ca_dir}" >&2
  exit 1
}
var resolved_ca_dir = ''
try { setvar resolved_ca_dir = $(readlink -f -- $ca_dir) }
if failed {
  echo $"ERROR: cannot resolve CA directory: ${ca_dir}" >&2
  exit 1
}
setvar ca_dir = resolved_ca_dir

cd $_this_dir/../.. {
  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = agenix_bw_primary_identity()
  if (recipient === '') {
    echo 'ERROR: cannot derive the master recipient from the Bitwarden key' >&2
    exit 1
  }

  var imported = 0
  var failed_count = 0
  var ca_crt = $"${ca_dir}/ca.crt"
  if (file_exists(ca_crt)) {
    mkdir -p nixos/networking/nebula
    try { cp -- $ca_crt nixos/networking/nebula/ca.crt }
    if failed {
      echo $"ERROR: cannot copy ${ca_crt}" >&2
      setvar failed_count += 1
    } else {
      echo 'OK: nixos/networking/nebula/ca.crt'
      setvar imported += 1
    }
  } else {
    echo $"SKIP: ${ca_crt} not found" >&2
  }

  for node in (FLEET) {
    var name = node.name
    var crt = $"${ca_dir}/${name}.crt"
    var key = $"${ca_dir}/${name}.key"
    if (not (file_exists(crt) and file_exists(key))) {
      echo $"SKIP: ${crt} or ${key} not found" >&2
      continue
    }

    var cert_target = $"hosts/${name}/nebula.crt"
    var key_target = $"secrets/master/hosts/${name}/nebula_key.age"
    mkdir -p $"hosts/${name}" $"secrets/master/hosts/${name}"

    try { cp -- $crt $cert_target }
    if failed {
      echo $"ERROR: cannot copy ${crt} to ${cert_target}" >&2
      setvar failed_count += 1
      continue
    }
    try { agenix_bw_encrypt_file (key, key_target, recipient) }
    if failed {
      echo $"ERROR: cannot encrypt ${key} to ${key_target}" >&2
      setvar failed_count += 1
      continue
    }

    echo $"OK: ${cert_target} and ${key_target}"
    setvar imported += 1
  }

  if (imported === 0) {
    echo $"ERROR: nothing imported from ${ca_dir}" >&2
    exit 1
  }
  if (failed_count > 0) {
    exit 1
  }

  echo
  echo $"Imported ${imported} item(s). Next: just secret-rekey"
}
