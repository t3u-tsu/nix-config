#!/usr/bin/env ysh
#
# Rotate the whole Nebula CA. Node IPs live inside the signed certs and are
# bounded by the CA's -networks, so a subnet change or CA expiry means issuing a
# new CA and re-signing every node — for a single new host, sign one cert
# against the existing CA instead. Re-running issues a NEW CA; only the
# passphrase in $CA_DIR/passphrase (chmod 600) is reused.
#
# Usage:
#   ysh scripts/nebula/rotate-ca.ysh [CA_DIR]
#
#   CA_DIR defaults to ~/.nebula-ca. The node list and subnet are loaded from
#   lib/nebula-fleet.nix by scripts/nebula/lib/fleet.ysh.
#
# Re-importing the new certs into agenix is a separate step:
#   ysh scripts/nebula/import-secrets.ysh "$CA_DIR"
#   just secret rekey

source $_this_dir/lib/fleet.ysh

const CA_NAME = 't3u-home-ca'
const DURATION = '87600h'

shopt --unset verbose_errexit

proc usage() {
  echo 'usage: ysh scripts/nebula/rotate-ca.ysh [CA_DIR]'
  echo ''
  echo '  CA_DIR   output directory (default: ~/.nebula-ca)'
}

var ca_dir = ''
var i = 0
while (i < len(ARGV)) {
  var arg = ARGV[i]
  if (arg === '-h' or arg === '--help') {
    usage
    exit 0
  } else {
    if (ca_dir !== '') {
      echo 'ERROR: only one CA_DIR may be given' >&2
      exit 2
    }
    setvar ca_dir = arg
    setvar i += 1
  }
}

if (ca_dir === '') {
  setvar ca_dir = default_ca_dir()
}
if (ca_dir === '') {
  echo 'ERROR: HOME is unset; pass CA_DIR explicitly.' >&2
  exit 2
}
var subnet = FLEET_SUBNET

for tool in (['nebula-cert', 'script', 'sort', 'base64']) {
  if (not command_exists(tool)) {
    echo $"ERROR: required tool '${tool}' not found. Run within nix develop, or add it to PATH." >&2
    exit 1
  }
}

var group_set = {}
for node in (FLEET) {
  for group in (node.groups) {
    setvar group_set[group] = true
  }
}
var group_names = @(printf '%s\n' @[keys(group_set)] | sort)
var ca_groups = join(group_names, ',')
if (ca_groups === '') {
  echo 'ERROR: no groups defined in FLEET.' >&2
  exit 1
}

echo '== Nebula CA rotation =='
echo $"  CA dir : ${ca_dir}"
echo $"  subnet : ${subnet}"
echo $"  CA gps : ${ca_groups}"
if (file_exists($"${ca_dir}/ca.crt")) {
  echo 'WARN: replacing the existing CA in this directory.' >&2
}

umask 077
mkdir -p $ca_dir

# nebula-cert prompts for a passphrase, so run it under a pty fed from stdin.
proc run_nebula(passphrase, ...cmd) {
  var quoted = []
  for arg in (cmd) {
    call quoted->append($(printf '%q' $arg))
  }
  var cmd_line = join(quoted, ' ')
  shopt --unset verbose_errexit {
    try { printf '%s\n' $passphrase | script -q -e -E never -c $cmd_line /dev/null }
  }
  if failed {
    echo $"ERROR: nebula-cert failed: ${cmd_line}" >&2
    return 1
  }
}

cd $ca_dir {
  if (file_exists('passphrase')) {
    echo 'Reusing the existing CA passphrase.'
  } else {
    head -c 24 /dev/urandom | base64 > passphrase
  }
  chmod 600 passphrase

  var passphrase = ''
  try { read --all (&passphrase) < passphrase }
  if failed {
    echo 'ERROR: cannot read the CA passphrase file.' >&2
    exit 1
  }
  setvar passphrase = passphrase.trim()
  if (passphrase === '') {
    echo 'ERROR: CA passphrase file is empty.' >&2
    exit 1
  }

  echo '== creating CA =='
  run_nebula $passphrase nebula-cert ca \
    -name $CA_NAME \
    -networks $subnet \
    -groups $ca_groups \
    -duration $DURATION \
    -encrypt \
    -out-crt ca.crt \
    -out-key ca.key

  for node in (FLEET) {
    var name = node.name
    var ip = node.ip
    var groups = join(node.groups, ',')
    echo $"== sign ${name} (${ip}/24, ${groups}) =="
    run_nebula $passphrase nebula-cert sign \
      -name $name \
      -networks $"${ip}/24" \
      -groups $groups \
      -ca-crt ca.crt \
      -ca-key ca.key \
      -out-crt $"${name}.crt" \
      -out-key $"${name}.key"
  }
}

echo
echo $"== done. Certificates written to ${ca_dir} =="
echo 'Next, re-import them (uses the Bitwarden master identity):'
echo $"  ysh scripts/nebula/import-secrets.ysh ${ca_dir}"
echo '  just secret rekey'
