#!/usr/bin/env ysh
#
# Shared Nebula mesh helpers. Loads the node fleet from lib/nebula-fleet.nix.
#
# Sourcing this file populates FLEET and FLEET_SUBNET and sets FLEET_LOADED;
# callers must check FLEET_LOADED and exit themselves.

source $_this_dir/../../lib/common.ysh

var FLEET = []
var FLEET_SUBNET = '10.0.0.0/24'

func default_ca_dir() {
  var home = get(ENV, 'HOME', '')
  if (home === '') {
    return ('')
  }
  return ($"${home}/.nebula-ca")
}

func load_fleet_from_nix() {
  var root_dir = _this_dir ++ '/../../..'
  var nix_file = root_dir ++ '/lib/nebula-fleet.nix'
  if (not file_exists(nix_file)) {
    echo $"ERROR: ${nix_file} not found" >&2
    return (false)
  }
  if (not command_exists('nix')) {
    echo 'ERROR: nix is required to read lib/nebula-fleet.nix; run within nix develop' >&2
    return (false)
  }
  var json_str = ''
  try { setvar json_str = $(nix eval --json --file $nix_file) }
  if failed {
    return (false)
  }
  if (json_str === '') {
    return (false)
  }
  var parsed = null
  try { json read (&parsed) <<< $json_str }
  if failed {
    return (false)
  }
  if (type(parsed) !== 'Dict') {
    return (false)
  }
  var subnet = get(parsed, 'subnet', null)
  if (subnet !== null) {
    setglobal FLEET_SUBNET = subnet
  }
  var fleet = get(parsed, 'fleet', null)
  if (fleet !== null) {
    setglobal FLEET = fleet
  }
  return (true)
}

var FLEET_LOADED = load_fleet_from_nix()

if is-main {
  if (not FLEET_LOADED) {
    echo 'ERROR: failed to load the Nebula fleet from lib/nebula-fleet.nix' >&2
    exit 1
  }
}
