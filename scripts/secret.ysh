#!/usr/bin/env ysh
#
# Unified CLI for the agenix-rekey secret workflows.
#
# Usage:
#   ysh scripts/secret.ysh migrate [--dry-run] [--force]
#   ysh scripts/secret.ysh rekey [agenix args...]
#   ysh scripts/secret.ysh edit <file>
#   ysh scripts/secret.ysh apply-staging [--dry-run] [--no-rekey]
#   ysh scripts/secret.ysh doctor
#
# The Bitwarden master identity is reused from agenix-bw-lib.ysh. An empty
# BW_SESSION triggers `bw unlock` only when stdin is a TTY; non-interactive
# runs must pass BW_SESSION.

source $_this_dir/agenix-bw-lib.ysh

const MANIFEST_PATH = 'secrets/migration-manifest.json'
const STAGING_DIR = '.secrets-staging'
const MASTER_DIR = 'secrets/master'

var manifest = null

proc usage() {
  echo 'usage: ysh scripts/secret.ysh <command> [args...]'
  echo ''
  echo 'commands:'
  echo '  migrate [--dry-run] [--force]           Encrypt SOPS secrets into manifest targets'
  echo '  rekey [agenix args...]                  Run agenix rekey with the master identity'
  echo '  edit <file>                             Edit a master secret file'
  echo '  apply-staging [--dry-run] [--no-rekey]  Encrypt .secrets-staging files and rekey'
  echo '  doctor                                  Check tools, manifest, Bitwarden, and staging'
}

proc die(msg) {
  echo $"ERROR: ${msg}" >&2
  exit 1
}

func is_safe_relative(path) {
  if (path === '' or path.startsWith('/')) {
    return (false)
  }
  for part in (path.split(u'/')) {
    if (part === '..') {
      return (false)
    }
  }
  return (true)
}

func parent_dir(path) {
  var parts = path.split(u'/')
  if (len(parts) < 2) {
    return ('.')
  }
  return (join(parts[0:len(parts) - 1], '/'))
}

func file_exists(path) {
  try { test -f $path }
  return (_error.code === 0)
}

func staging_target(file) {
  var rel = file
  if (rel.startsWith(STAGING_DIR ++ '/')) {
    setvar rel = rel[len(STAGING_DIR ++ '/'):]
  }
  if (rel.startsWith(MASTER_DIR ++ '/')) {
    setvar rel = rel[len(MASTER_DIR ++ '/'):]
  }
  if (not is_safe_relative(rel)) {
    return (null)
  }
  if (rel.endsWith('.age')) {
    return (MASTER_DIR ++ '/' ++ rel)
  }
  return (MASTER_DIR ++ '/' ++ rel ++ '.age')
}

proc load_manifest() {
  setglobal manifest = null
  var text = ''
  try { read --all (&text) < $MANIFEST_PATH }
  if failed {
    echo $"ERROR: cannot read ${MANIFEST_PATH}" >&2
    return
  }

  var parsed = null
  try { json read (&parsed) <<< $text }
  if failed {
    echo $"ERROR: ${MANIFEST_PATH} is not valid JSON" >&2
    return
  }
  if (type(parsed) !== 'Dict' or type(get(parsed, 'entries', null)) !== 'List') {
    echo $"ERROR: ${MANIFEST_PATH} must contain an entries list" >&2
    return
  }
  setglobal manifest = parsed
}

proc shred_staged(file) {
  try { shred -u $file }
  if failed {
    try { rm -f $file }
  }
  if failed {
    echo $"WARN: could not remove staged file ${file}" >&2
  }
}

proc agenix_with_identity(; args) {
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  var pubkey = ''
  try { setvar pubkey = $(age-keygen -y $agenix_bw_key_path) }
  if failed {
    setvar pubkey = ''
  }
  env AGENIX_MASTER_KEY_FILE=$agenix_bw_key_path \
    AGENIX_REKEY_PRIMARY_IDENTITY=$pubkey \
    $agenix_cmd @[args]
}

proc run_with_agenix(; args) {
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  agenix_bw_require 'bw'
  agenix_bw_require $agenix_cmd
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity
  agenix_with_identity (args)
}

proc migrate(; args) {
  var dry_run = false
  var force = false
  for arg in (args) {
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--dry-run') { setvar dry_run = true }
      ('--force') { setvar force = true }
      (else) {
        echo $"ERROR: unknown argument: ${arg}" >&2
        exit 2
      }
    }
  }

  load_manifest
  if (manifest === null) {
    exit 1
  }

  var master_recipient = get(manifest, 'masterRecipient', '')
  if (master_recipient === '') {
    die 'manifest has no masterRecipient'
  }

  var groups = {}
  var target_order = []
  for entry in (get(manifest, 'entries', [])) {
    var action = get(entry, 'action', '')
    if (action === 'generate' or action === 'drop' or action === 'bitwarden') {
      continue
    }
    if (action !== 'encrypt' and action !== 'publish') {
      die $"unknown manifest action: ${action}"
    }
    if (get(entry, 'source', '') === '' or get(entry, 'key', '') === '') {
      die "manifest entry lacks source or key"
    }
    var source_path = get(entry, 'source', '')
    if (not file_exists(source_path)) {
      die $"missing migration source: ${source_path}"
    }

    var target = get(entry, 'target', null)
    if (target === null or not is_safe_relative(target)) {
      die $"unsafe migration target: ${target}"
    }
    var format = get(entry, 'format', 'raw')
    if (format !== 'raw' and format !== 'env') {
      die $"unknown manifest format for ${target}: ${format}"
    }
    if (target in groups) {
      if (groups[target].action !== action or groups[target].format !== format) {
        die $"conflicting manifest entries for ${target}"
      }
      if (format !== 'env') {
        die $"duplicate target without env format: ${target}"
      }
    } else {
      setvar groups[target] = { action: action, format: format, entries: [] }
      call target_order->append(target)
    }
    call groups[target].entries->append(entry)
  }
  if (len(target_order) === 0) {
    die 'manifest has no migratable entries'
  }

  if (dry_run) {
    for target in (target_order) {
      var plan_group = groups[target]
      var plan_action = plan_group.action
      var plan_key_count = len(plan_group.entries)
      echo $"PLAN: ${plan_action} ${target} <- ${plan_key_count} key(s)"
    }
    var target_count = len(target_order)
    echo $"Dry run: ${target_count} target(s) planned."
    return
  }

  shopt --unset verbose_errexit
  agenix_bw_require 'bw'
  agenix_bw_require 'sops'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = ''
  try { setvar recipient = $(age-keygen -y $agenix_bw_key_path) }
  if failed {
    die 'cannot derive the master recipient from the Bitwarden key'
  }
  if (recipient !== master_recipient) {
    die $"Bitwarden key recipient ${recipient} does not match manifest ${master_recipient}"
  }

  var decrypted = {}
  var written = 0
  var skipped = 0
  var failed_count = 0

  for target in (target_order) {
    var group = groups[target]
    if (file_exists(target) and not force) {
      var existing = ''
      try { read --all (&existing) < $target }
      if (not existing.contains('PLACEHOLDER')) {
        echo $"SKIP: ${target} exists (use --force to overwrite)"
        setvar skipped += 1
        continue
      }
    }

    var lines = []
    var group_failed = false
    for entry in (group.entries) {
      var source = get(entry, 'source', '')
      var key = get(entry, 'key', '')
      if (source === '' or key === '') {
        echo $"ERROR: manifest entry for ${target} lacks source or key" >&2
        setvar group_failed = true
        continue
      }

      if (not (source in decrypted)) {
        var raw = ''
        try { setvar raw = $(env SOPS_AGE_KEY_FILE=$agenix_bw_key_path sops --decrypt --output-type json $source) }
        if failed {
          echo $"ERROR: cannot decrypt ${source}" >&2
          setvar group_failed = true
          continue
        }
        var parsed = null
        try { json read (&parsed) <<< $raw }
        if failed {
          echo $"ERROR: ${source} did not decrypt to valid JSON" >&2
          setvar group_failed = true
          continue
        }
        setvar decrypted[source] = parsed
      }

      var value = get(decrypted[source], key, null)
      if (value === null) {
        echo $"ERROR: ${source} has no key ${key}" >&2
        setvar group_failed = true
        continue
      }

      if (group.format === 'env') {
        if (type(value) !== 'Str' or value.contains(u'\n')) {
          echo $"ERROR: ${source}:${key} is not a single-line env value" >&2
          setvar group_failed = true
          continue
        }
        call lines->append(key ++ '=' ++ value)
      } elif (type(value) === 'Str') {
        call lines->append(value)
      } else {
        var encoded = $(json write (value))
        call lines->append(encoded)
      }
    }
    if (group_failed) {
      setvar failed_count += 1
      continue
    }

    var content = ''
    if (group.format === 'env') {
      for line in (lines) {
        setvar content = content ++ line ++ u'\n'
      }
    } else {
      setvar content = lines[0]
    }

    mkdir -p $[parent_dir(target)]
    if (group.action === 'publish') {
      write --end '' -- $content > $target
      echo $"OK: published ${target}"
      setvar written += 1
      continue
    }

    try { write --end '' -- $content | age -r $recipient -o $target }
    if failed {
      echo $"ERROR: failed to encrypt ${target}" >&2
      setvar failed_count += 1
      continue
    }
    echo $"OK: encrypted ${target}"
    setvar written += 1
  }

  echo $"Wrote ${written}, skipped ${skipped}, failed ${failed_count}."
  try { git add -N secrets/ 2>/dev/null }
  try { git add -N nixos/networking/nebula/ 2>/dev/null }
  try { git add -N hosts/*/nebula.crt 2>/dev/null }
  if (failed_count > 0) {
    exit 1
  }
}

proc rekey(; args) {
  shopt --unset verbose_errexit
  try { git add -N secrets/ 2>/dev/null }
  try { git add -N nixos/networking/nebula/ 2>/dev/null }
  try { git add -N hosts/*/nebula.crt 2>/dev/null }
  run_with_agenix (['rekey'] ++ args)
  try { git add -N secrets/ 2>/dev/null }
}

proc edit(; args) {
  if (len(args) !== 1) {
    usage
    exit 2
  }
  var file = args[0]
  if (not file_exists(file)) {
    die $"secret file not found: ${file}"
  }
  shopt --unset verbose_errexit
  run_with_agenix (['edit', file])
}

proc apply_staging(; args) {
  var dry_run = false
  var no_rekey = false
  for arg in (args) {
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--dry-run') { setvar dry_run = true }
      ('--no-rekey') { setvar no_rekey = true }
      (else) {
        echo $"ERROR: unknown argument: ${arg}" >&2
        exit 2
      }
    }
  }

  try { test -d $STAGING_DIR }
  if failed {
    echo $"No ${STAGING_DIR} directory; nothing to apply."
    return
  }

  var find_out = ''
  try { setvar find_out = $(find $STAGING_DIR -type f -not -name '.*' -not -name '*~' -not -name '*.swp') }
  if failed {
    die $"cannot scan ${STAGING_DIR}"
  }

  var plan = []
  var seen = {}
  for file in (find_out.split(u'\n')) {
    if (file === '') {
      continue
    }
    var target = staging_target(file)
    if (target === null) {
      die $"unsafe staging path: ${file}"
    }
    if (target in seen) {
      var prior = seen[target]
      die $"both ${prior} and ${file} map to ${target}"
    }
    setvar seen[target] = file
    call plan->append({ source: file, target: target })
  }
  if (len(plan) === 0) {
    echo $"No staged secrets in ${STAGING_DIR}."
    return
  }

  if (dry_run) {
    for item in (plan) {
      var plan_target = item.target
      var plan_source = item.source
      echo $"PLAN: ${plan_target} <- ${plan_source}"
    }
    var plan_count = len(plan)
    echo $"Dry run: ${plan_count} staged file(s)."
    return
  }

  shopt --unset verbose_errexit
  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = ''
  try { setvar recipient = $(age-keygen -y $agenix_bw_key_path) }
  if failed {
    die 'cannot derive the master recipient from the Bitwarden key'
  }
  if (file_exists(MANIFEST_PATH)) {
    load_manifest
    if (manifest !== null) {
      var manifest_recipient = get(manifest, 'masterRecipient', '')
      if (manifest_recipient !== '' and recipient !== manifest_recipient) {
        die $"Bitwarden key recipient ${recipient} does not match manifest ${manifest_recipient}"
      }
    }
  }

  var written = 0
  var failed_count = 0
  for item in (plan) {
    var item_source = item.source
    var item_target = item.target
    var content = ''
    try { read --all (&content) < $item_source }
    if failed {
      echo $"ERROR: cannot read ${item_source}" >&2
      setvar failed_count += 1
      continue
    }

    mkdir -p $[parent_dir(item_target)]
    try { write --end '' -- $content | age -r $recipient -o $item_target }
    if failed {
      echo $"ERROR: failed to encrypt ${item_target}" >&2
      setvar failed_count += 1
      continue
    }
    echo $"OK: encrypted ${item_target}"
    setvar written += 1
    shred_staged $item_source
  }

  try { find $STAGING_DIR -mindepth 1 -type d -empty -delete }
  if failed {
    echo $"WARN: could not prune empty directories under ${STAGING_DIR}" >&2
  }

  var staged_left = ''
  try { setvar staged_left = $(find $STAGING_DIR -type f 2>/dev/null) }
  if failed {
    setvar staged_left = ''
  }
  if (staged_left !== '') {
    echo $"WARN: staged plaintext remains in ${STAGING_DIR}" >&2
    setvar failed_count += 1
  }
  try { rmdir $STAGING_DIR }

  if (written > 0 and not no_rekey) {
    var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
    agenix_bw_require $agenix_cmd
    agenix_with_identity (['rekey'])
  }
  if (failed_count > 0) {
    exit 1
  }
}

proc doctor(; args) {
  if (len(args) > 0) {
    usage
    exit 2
  }

  var errors = 0
  var warnings = 0

  for tool in (['bw', 'age', 'age-keygen', 'sops', 'agenix', 'git']) {
    try { command -v $tool >/dev/null 2>&1 }
    if failed {
      echo $"ERROR: ${tool} not found on PATH"
      setvar errors += 1
    } else {
      echo $"OK: ${tool}"
    }
  }

  load_manifest
  if (manifest === null) {
    setvar errors += 1
  } else {
    var recipient = get(manifest, 'masterRecipient', '')
    if (not recipient.startsWith('age1')) {
      echo 'ERROR: manifest masterRecipient is not an age public key'
      setvar errors += 1
    } else {
      echo $"OK: master recipient ${recipient}"

      var sops_config = ''
      try { read --all (&sops_config) < '.sops.yaml' }
      if failed {
        echo 'WARN: cannot read .sops.yaml'
        setvar warnings += 1
      } elif (not sops_config.contains(recipient)) {
        echo 'ERROR: manifest masterRecipient is not present in .sops.yaml'
        setvar errors += 1
      } else {
        echo 'OK: manifest recipient matches .sops.yaml'
      }

      var agenix_config = ''
      try { read --all (&agenix_config) < 'nixos/security/agenix.nix' }
      if failed {
        echo 'WARN: cannot read nixos/security/agenix.nix'
        setvar warnings += 1
      } elif (not agenix_config.contains(recipient)) {
        echo 'ERROR: manifest masterRecipient is not present in age.rekey.masterIdentities'
        setvar errors += 1
      } else {
        echo 'OK: manifest recipient matches age.rekey.masterIdentities'
      }
    }

    var entries = get(manifest, 'entries', [])
    var entry_count = len(entries)
    echo $"OK: manifest contains ${entry_count} entries"

    var sources = {}
    var targets = {}
    var missing = 0
    for entry in (entries) {
      var action = get(entry, 'action', '')
      var source = get(entry, 'source', '')
      var key = get(entry, 'key', '')
      if (source === '' or key === '') {
        echo 'ERROR: manifest entry lacks source or key'
        setvar errors += 1
        continue
      }
      setvar sources[source] = true

      if (action === 'encrypt' or action === 'publish') {
        var target = get(entry, 'target', null)
        if (target === null or not is_safe_relative(target)) {
          echo $"ERROR: unsafe target for ${source}:${key}"
          setvar errors += 1
          continue
        }
        if (action === 'encrypt' and not target.startsWith(MASTER_DIR ++ '/')) {
          echo $"ERROR: encrypted target is outside ${MASTER_DIR}: ${target}"
          setvar errors += 1
        }
        if (not (target in targets)) {
          setvar targets[target] = true
          if (not file_exists(target)) {
            setvar missing += 1
          }
        }
      } elif (action === 'generate' or action === 'drop') {
        if (get(entry, 'target', null) !== null) {
          echo $"WARN: ${source}:${key} is ${action} but has a target"
          setvar warnings += 1
        }
      } elif (action !== 'bitwarden') {
        echo $"ERROR: unknown action '${action}' for ${source}:${key}"
        setvar errors += 1
      }
    }

    for manifest_source, _ in (sources) {
      if (not file_exists(manifest_source)) {
        echo $"ERROR: manifest source is missing: ${manifest_source}"
        setvar errors += 1
      }
    }
    if (missing > 0) {
      echo $"WARN: ${missing} manifest target(s) are missing; run just secret-migrate"
      setvar warnings += 1
    } else {
      echo 'OK: all manifest targets exist'
    }
  }

  try { git check-ignore -q $STAGING_DIR/probe }
  if failed {
    echo $"WARN: ${STAGING_DIR}/ is not ignored by git"
    setvar warnings += 1
  } else {
    echo $"OK: ${STAGING_DIR}/ is ignored by git"
  }

  var staged_count = 0
  var staged_out = ''
  try { setvar staged_out = $(find $STAGING_DIR -type f 2>/dev/null) }
  if failed {
    setvar staged_out = ''
  }
  for file in (staged_out.split(u'\n')) {
    if (file !== '') {
      setvar staged_count += 1
    }
  }
  if (staged_count > 0) {
    echo $"WARN: ${staged_count} staged plaintext file(s) await just secret-apply-staging"
    setvar warnings += 1
  } else {
    echo 'OK: no staged plaintext files'
  }

  var bw_status = ''
  try { setvar bw_status = $(env -u BW_SESSION bw status --raw) }
  if failed {
    echo 'WARN: cannot read Bitwarden status'
    setvar warnings += 1
  } elif (bw_status === '') {
    echo 'WARN: Bitwarden status was empty'
    setvar warnings += 1
  } else {
    var status_obj = null
    try { json read (&status_obj) <<< $bw_status }
    if failed {
      echo 'WARN: Bitwarden status was not valid JSON'
      setvar warnings += 1
    } else {
      var state = get(status_obj, 'status', 'unknown')
      echo $"INFO: Bitwarden vault is ${state}"
      if (state === 'unauthenticated') {
        echo 'ERROR: Bitwarden is not logged in; run bw login'
        setvar errors += 1
      }
    }
  }

  if (get(ENV, 'BW_SESSION', '') === '') {
    echo 'INFO: BW_SESSION is unset; interactive commands unlock via a TTY'
  } else {
    echo 'OK: BW_SESSION is set'
  }

  echo $"Doctor: ${errors} error(s), ${warnings} warning(s)."
  if (errors > 0) {
    exit 1
  }
}

if (len(ARGV) === 0) {
  usage
  exit 2
}

var command = ARGV[0]
var command_args = []
var index = 0
for arg in (ARGV) {
  if (index > 0) {
    call command_args->append(arg)
  }
  setvar index += 1
}

cd $_this_dir/.. {
  case (command) {
    ('migrate') { migrate (command_args) }
    ('rekey') { rekey (command_args) }
    ('edit') { edit (command_args) }
    ('apply-staging') { apply_staging (command_args) }
    ('doctor') { doctor (command_args) }
    ('-h') { usage }
    ('--help') { usage }
    (else) {
      echo $"ERROR: unknown command: ${command}" >&2
      usage
      exit 2
    }
  }
}
