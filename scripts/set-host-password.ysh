#!/usr/bin/env ysh
#
# Usage: SOPS_AGE_KEY_FILE=<master age key> ysh scripts/set-host-password.ysh <hostname>
#
# <hostname> is a hosts/<name>/ directory; the SOPS keys written are
# <hostkey>_t3u_password_hash and <hostkey>_root_password_hash (<hostkey> =
# lowercased hostname, '-' -> '_'). The master key is needed only when the
# secrets file already exists. mkpasswd and sops must be on PATH:
#   nix shell nixpkgs#mkpasswd nixpkgs#sops -c ysh scripts/set-host-password.ysh x1c7

source $_this_dir/nebula-lib.ysh

if (len(ARGV) < 1) {
  echo 'usage: ysh scripts/set-host-password.ysh <hostname>' >&2
  exit 2
}

var host = ARGV[0]
var hostkey = host_key(host)
var file = host_secrets_file(host)

shopt --unset verbose_errexit

for tool in (['mkpasswd', 'sops']) {
  try { command -v $tool >/dev/null }
  if failed {
    echo $"ERROR: ${tool} not found. Run via: nix shell nixpkgs#mkpasswd nixpkgs#sops -c ysh $0 ${host}" >&2
    exit 1
  }
}

read -rsp "password for t3u: " t3u_password
echo
read -rsp "password for root: " root_password
echo
if (t3u_password === '' or root_password === '') {
  echo 'ERROR: empty password' >&2
  exit 1
}

# mkpasswd hashes a password passed as an argument, which would expose it in
# /proc/<pid>/cmdline; -s reads it from stdin instead.
var t3u_hash = $(printf '%s\n' $t3u_password | mkpasswd -m sha-512 -s)
var root_hash = $(printf '%s\n' $root_password | mkpasswd -m sha-512 -s)
unset t3u_password root_password
if (not (t3u_hash.startsWith('$6$') and root_hash.startsWith('$6$'))) {
  echo 'ERROR: mkpasswd returned no sha-512 hash' >&2
  exit 1
}

var t3u_path = '["' ++ hostkey ++ '_t3u_password_hash"]'
var root_path = '["' ++ hostkey ++ '_root_password_hash"]'

if (file_exists(file)) {
  # sops set has to decrypt the file to merge the two hashes, and host secrets
  # deliberately exclude the user key, so only the offline master key can do it.
  try { var _ = ENV.SOPS_AGE_KEY_FILE }
  if failed {
    echo $"ERROR: set SOPS_AGE_KEY_FILE to the master age key that can decrypt ${file}" >&2
    exit 1
  }
  sops set $file $t3u_path $(json write (t3u_hash))
  sops set $file $root_path $(json write (root_hash))
} else {
  # A new file is encrypted from plaintext, which only needs the public keys.
  # The plaintext lives outside the repo, and --filename-override picks the
  # .sops.yaml creation rule for $file, since rules match on the path.
  var plain = $(mktemp)
  trap --add EXIT { rm -f $plain }
  printf '%s_t3u_password_hash: "%s"\n%s_root_password_hash: "%s"\n' \
    $hostkey $t3u_hash $hostkey $root_hash > $plain
  sops encrypt --filename-override $file --output $file $plain
}
unset t3u_hash root_hash

echo $"OK: set ${hostkey}_t3u_password_hash / ${hostkey}_root_password_hash in ${file}"
