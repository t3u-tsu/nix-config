#!/usr/bin/env ysh
#
# Rebind and recover the AMD I2C controller and Synaptics touchpad on HP Victus 16.
#
# Usage:
#   ysh scripts/hardware/restart-touchpad.ysh
#
# Re-executes through pkexec when not running as root.

source $_this_dir/../lib/common.ysh

shopt --unset verbose_errexit

const CONTROLLER = 'AMDI0010:03'
const PLATFORM_DIR = '/sys/bus/platform/drivers/i2c_designware'
const I2C_DIR = '/sys/bus/i2c/drivers/i2c_hid_acpi'
const TOUCHPAD = 'i2c-SYNA32CD:00'

func resolve_parent(path) {
  var parts = path.split(u'/')
  if (len(parts) < 2) {
    return ('.')
  }
  return (join(parts[0:len(parts) - 1], '/'))
}

func find_ysh() {
  if (command_exists('ysh')) {
    return ($(command -v ysh))
  }
  var exe = ''
  try { setvar exe = $(readlink -f /proc/$$/exe) }
  if failed {
    return ('')
  }
  return (resolve_parent(exe) ++ '/ysh')
}

proc set_power_control() {
  var control = $"/sys/bus/platform/devices/${CONTROLLER}/power/control"
  if (not path_exists(control)) {
    return
  }
  try { echo 'on' > $control }
  if failed {
    echo $"WARN: cannot force ${control} to on." >&2
  }
}

proc elevate_via_pkexec(script_path; ; argv) {
  var pkexec_bin = ''
  try { setvar pkexec_bin = $(command -v pkexec 2>/dev/null) }
  if failed {
    setvar pkexec_bin = ''
  }
  if (pkexec_bin === '') {
    die 'pkexec is required to elevate privileges but was not found.'
  }
  var ysh_bin = find_ysh()
  if (ysh_bin === '' or not path_exists(ysh_bin)) {
    die 'cannot locate the ysh interpreter for pkexec.'
  }
  echo '[restart-touchpad] Root privileges required; requesting elevation via pkexec...'
  exec $pkexec_bin $ysh_bin $script_path @argv
}

proc main(; argv) {
  var script_path = $(readlink -f $0)
  if ($(id -u) !== '0') {
    elevate_via_pkexec $script_path (argv=argv)
  }

  if (not path_exists(PLATFORM_DIR)) {
    die $"${PLATFORM_DIR} not found; this host does not use the AMD DesignWare I2C driver."
  }

  # The controller can stay asleep after a suspend/resume cycle, so force it on
  # before rebinding the driver.
  set_power_control

  if (path_exists($"${PLATFORM_DIR}/${CONTROLLER}")) {
    try { echo $CONTROLLER > $"${PLATFORM_DIR}/unbind" }
    if failed {
      die $"cannot unbind ${CONTROLLER}."
    }
    sleep 0.5
  }

  if (path_exists($"/sys/bus/platform/devices/${CONTROLLER}")) {
    try { echo $CONTROLLER > $"${PLATFORM_DIR}/bind" }
    if failed {
      die $"cannot bind ${CONTROLLER}."
    }
    sleep 0.5
  }

  set_power_control

  if (path_exists($"/sys/bus/i2c/devices/${TOUCHPAD}") and not path_exists($"${I2C_DIR}/${TOUCHPAD}")) {
    try { echo $TOUCHPAD > $"${I2C_DIR}/bind" }
    if failed {
      die $"cannot bind ${TOUCHPAD}."
    }
  }

  echo '[restart-touchpad] Recovery sequence completed.'
}

if is-main { main (ARGV) }
