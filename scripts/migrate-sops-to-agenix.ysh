#!/usr/bin/env ysh
#
# Migrates SOPS YAML secrets to individual agenix-rekey master .age files.
#
# Usage:
#   ysh scripts/migrate-sops-to-agenix.ysh [--dry-run] [--force]
#
# The age identity is read from Bitwarden (same settings as agenix-with-bw.ysh)
# and must be the master key that decrypts .sops.yaml's secrets. Each top-level
# SOPS key becomes secrets/master/<key>.age, encrypted to that identity's
# public key. Non-string values are written as JSON. Existing .age files are
# skipped unless --force is passed; the SOPS files are left untouched.

source $_this_dir/agenix-bw-lib.ysh

var dry_run = false
var force = false

proc usage() {
  echo 'usage: ysh scripts/migrate-sops-to-agenix.ysh [--dry-run] [--force]'
  echo '  --dry-run  Print the migration plan without writing files'
  echo '  --force    Overwrite existing secrets/master/<key>.age files'
}

for arg in (ARGV) {
  case (arg) {
    ('-h' | '--help') { usage; exit 0 }
    ('--dry-run') { setvar dry_run = true }
    ('--force') { setvar force = true }
    (else) {
      echo $"ERROR: unknown argument: ${arg}" >&2
      usage
      exit 2
    }
  }
}

shopt --unset verbose_errexit

agenix_bw_require 'bw'
agenix_bw_require 'sops'
agenix_bw_require 'age'
agenix_bw_require 'age-keygen'
agenix_bw_session_init
agenix_bw_fetch_identity
agenix_bw_install_identity

cd $_this_dir/.. {
  var recipient = $(age-keygen -y $agenix_bw_key_path)
  echo $"Master recipient: ${recipient}"

  var out_dir = 'secrets/master'
  if (not dry_run) {
    mkdir -p $out_dir
  }

  var plain = ''
  if (not dry_run) {
    setvar plain = $(mktemp $"${agenix_bw_key_dir}/plaintext.XXXXXX")
    trap --add EXIT { rm -f $plain }
  }

  var sources = glob('secrets/common.yaml') ++ glob('secrets/hosts/*.yaml') ++ glob('secrets/services/*.yaml')
  if (len(sources) === 0) {
    echo 'ERROR: no SOPS secret files found under secrets/' >&2
    exit 1
  }

  var seen = {}
  var written = 0
  var skipped = 0
  var failed = 0

  for file in (sources) {
    var json_text = ''
    try { setvar json_text = $(env SOPS_AGE_KEY_FILE=$agenix_bw_key_path sops --decrypt --output-type json $file) }
    if failed {
      echo $"ERROR: cannot decrypt ${file}; does the Bitwarden key match .sops.yaml master_key?" >&2
      setvar failed += 1
      continue
    }

    var data = null
    try { json read (&data) <<< $json_text }
    if failed {
      echo $"ERROR: ${file} did not decrypt to valid JSON" >&2
      setvar failed += 1
      continue
    }

    for key, value in (data) {
      if (key === 'sops') { continue }
      if (key === '' or key.contains('/') or key.contains('..')) {
        echo $"ERROR: unsafe secret name '${key}' in ${file}" >&2
        setvar failed += 1
        continue
      }
      if (key in seen) {
        echo $"ERROR: duplicate secret '${key}' in ${file} and ${seen[key]}" >&2
        setvar failed += 1
        continue
      }
      setvar seen[key] = file

      var dest = $"${out_dir}/${key}.age"
      if (file_exists(dest) and not force) {
        echo $"SKIP: ${dest} exists (use --force to overwrite)" >&2
        setvar skipped += 1
        continue
      }
      if (dry_run) {
        echo $"PLAN: ${key} <- ${file}"
        continue
      }

      var value_type = type(value)
      if (value_type === 'Str') {
        write --end '' -- $value > $plain
      } elif (value_type === 'Null') {
        write --end '' -- '' > $plain
      } else {
        json write (value) > $plain
      }

      try { age -r $recipient -o $dest $plain }
      if failed {
        echo $"ERROR: failed to encrypt ${dest}" >&2
        setvar failed += 1
        continue
      }
      echo $"OK: ${key} -> ${dest}"
      setvar written += 1
    }
  }

  if (dry_run) {
    echo $"Dry run: ${written + skipped + failed} secret(s) inspected, nothing written."
  } else {
    echo $"Wrote ${written}, skipped ${skipped}, failed ${failed}."
  }
  if (failed > 0) {
    exit 1
  }
}
