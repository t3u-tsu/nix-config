#!/usr/bin/env ysh
# Single source of truth for the node list: add a new host here, sign its cert,
# then re-import it with scripts/nebula-import-secrets.ysh (see
# docs/operations/adding-a-host.md).

const FLEET = [
  {name: 'torii-chan', octet: 1, groups: ['mgmt']},
  {name: 'sando-kun', octet: 2, groups: ['mgmt']},
  {name: 'kagutsuchi-sama', octet: 3, groups: ['mgmt']},
  {name: 'shosoin-tan', octet: 4, groups: ['mgmt', 'app']},
  {name: 'BrokenPC', octet: 100, groups: ['mgmt', 'app']},
  {name: 'x1c7', octet: 101, groups: ['mgmt', 'app']},
]

func file_exists(path) {
  try { test -f $path }
  return (_error.code === 0)
}
