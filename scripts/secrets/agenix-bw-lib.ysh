#!/usr/bin/env ysh
#
# Shared Bitwarden helpers for the agenix secret scripts. Source this file,
# then call agenix_bw_session_init, agenix_bw_fetch_identity and
# agenix_bw_install_identity in that order. Callers also get the log_section,
# log_*/report_* formatting helpers and agenix_bw_confirm for [y/N] prompts.
#
# Environment:
#   BW_SESSION             Existing Bitwarden session; otherwise the session
#                          cached in $AGENIX_MASTER_KEY_DIR/bw-session is
#                          reused, and `bw login` or `bw unlock` runs when
#                          stdin is a TTY.
#   BW_MASTER_KEY_ITEM     Item name (default: agenix-master-key).
#   BW_MASTER_KEY_FIELD    notes, password, or a custom field name (default: notes).
#   AGENIX_MASTER_KEY_DIR  Identity directory (default: /run/agenix-master,
#                          the noswap tmpfs mounted by nixos/security/agenix.nix).
#   AGENIX_MASTER_KEY_DIR_ALLOW_UNSAFE
#                          Set to 1 to allow an unhardened (non-tmpfs or
#                          swappable) identity directory.
#   AGENIX_REQUIRE_SWAP_GUARD
#                          Set to 1 to abort instead of continuing when the
#                          no-swap systemd scope cannot be entered.
#   NO_COLOR               Any non-empty value disables ANSI colors in the
#                          log_*/report_* helpers and the [y/N] prompt.
#
# The identity is written to $AGENIX_MASTER_KEY_DIR/master-key.txt with mode
# 0400. EXIT/INT/TERM/HUP/QUIT traps remove it. Call
# `agenix_bw_swap_guard $0 @[ARGV]` immediately after sourcing so the process
# tree runs in a systemd scope with swap disabled.

ulimit -c 0
umask 077

# --- Log output ---
#
# Colors are resolved per stream: NO_COLOR disables them, and each helper
# checks the fd it writes to, so `| cat` and `2>log` both stay plain.

const agenix_bw_ansi_reset = u'\u{1b}[0m'
const agenix_bw_ansi_bold_cyan = u'\u{1b}[1;36m'
const agenix_bw_ansi_green = u'\u{1b}[32m'
const agenix_bw_ansi_cyan = u'\u{1b}[36m'
const agenix_bw_ansi_yellow = u'\u{1b}[33m'
const agenix_bw_ansi_red = u'\u{1b}[31m'
const agenix_bw_label_width = 22

func agenix_bw_is_tty(fd) {
  try { test -t $fd }
  return (_error.code === 0)
}

func agenix_bw_stdin_is_tty() {
  return (agenix_bw_is_tty(0))
}

var agenix_bw_color_stdout = (get(ENV, 'NO_COLOR', '') === '' and agenix_bw_is_tty(1))
var agenix_bw_color_stderr = (get(ENV, 'NO_COLOR', '') === '' and agenix_bw_is_tty(2))
var agenix_bw_section_open = false

func agenix_bw_paint(text, color, enabled) {
  if (not enabled) {
    return (text)
  }
  return (color ++ text ++ agenix_bw_ansi_reset)
}

func agenix_bw_pad(text, width) {
  var padded = text
  var remaining = width - len(text)
  while (remaining > 0) {
    setvar padded = padded ++ ' '
    setvar remaining -= 1
  }
  return (padded)
}

func agenix_bw_status_line(symbol, color, message, enabled) {
  return (agenix_bw_paint(symbol, color, enabled) ++ ' ' ++ message)
}

func agenix_bw_field_line(symbol, color, label, detail, enabled) {
  var padded = agenix_bw_pad(label, agenix_bw_label_width)
  return ('  ' ++ agenix_bw_paint(symbol, color, enabled) ++ ' ' ++ padded ++ ' ' ++ detail)
}

proc log_section(title) {
  if (agenix_bw_section_open) {
    echo ''
  }
  setglobal agenix_bw_section_open = true
  var header = agenix_bw_paint($"▸ ${title}", agenix_bw_ansi_bold_cyan, agenix_bw_color_stdout)
  echo $header
}

proc agenix_bw_emit_status(symbol, color, msg, stream) {
  var enabled = agenix_bw_color_stdout
  if (stream === 'stderr') {
    setvar enabled = agenix_bw_color_stderr
  }
  var line = agenix_bw_status_line(symbol, color, msg, enabled)
  if (stream === 'stderr') {
    echo $line >&2
  } else {
    echo $line
  }
}

# One-line status messages: ✓ progress, • context, ! warning, ✗ failure.
# `stream` matches the fd the caller expects so the color decision follows it.
proc log_ok(msg; ; stream='stdout') {
  agenix_bw_emit_status '✓' $agenix_bw_ansi_green $msg $stream
}

proc log_info(msg; ; stream='stdout') {
  agenix_bw_emit_status '•' $agenix_bw_ansi_cyan $msg $stream
}

proc log_warn(msg; ; stream='stderr') {
  agenix_bw_emit_status '!' $agenix_bw_ansi_yellow $msg $stream
}

proc log_error(msg; ; stream='stderr') {
  agenix_bw_emit_status '✗' $agenix_bw_ansi_red $msg $stream
}

proc log_die(msg) {
  log_error $msg
  exit 1
}

# Aligned report rows stay on stdout so `doctor > report.txt` keeps every
# finding; the single-line log_* helpers keep warnings on stderr.
proc report_ok(label, detail) {
  var line = agenix_bw_field_line('✓', agenix_bw_ansi_green, label, detail, agenix_bw_color_stdout)
  echo $line
}

proc report_warn(label, detail) {
  var line = agenix_bw_field_line('!', agenix_bw_ansi_yellow, label, detail, agenix_bw_color_stdout)
  echo $line
}

proc report_error(label, detail) {
  var line = agenix_bw_field_line('✗', agenix_bw_ansi_red, label, detail, agenix_bw_color_stdout)
  echo $line
}

# Prompts on stderr so piped stdout stays clean; without a TTY it returns
# false instead of waiting. Only y/yes accept, matching the [y/N] default.
func agenix_bw_confirm(prompt) {
  if (not agenix_bw_stdin_is_tty()) {
    return (false)
  }
  var question = agenix_bw_paint('?', agenix_bw_ansi_cyan, agenix_bw_color_stderr) ++ ' ' ++ prompt ++ ' [y/N]: '
  write --end '' -- $question >&2
  var answer = ''
  try { read -r answer }
  if failed {
    return (false)
  }
  var normalized = answer.trim().lower()
  return (normalized === 'y' or normalized === 'yes')
}

var agenix_bw_session = get(ENV, 'BW_SESSION', '')
var agenix_bw_session_from_env = agenix_bw_session !== ''
var agenix_bw_session_from_cache = false
var agenix_bw_identity = ''
var agenix_bw_key_dir = ''
var agenix_bw_key_path = ''
var agenix_bw_tmp_path = ''
var agenix_bw_item_raw = ''
var agenix_bw_item_name = ''
var agenix_bw_temp_files = []
var agenix_bw_trap_installed = false

func agenix_bw_command_exists(name) {
  try { command -v $name >/dev/null 2>&1 }
  return (_error.code === 0)
}

proc agenix_bw_cleanup() {
  if (agenix_bw_tmp_path !== '') {
    try { rm -f -- $agenix_bw_tmp_path }
  }
  if (agenix_bw_key_path !== '') {
    try { rm -f -- $agenix_bw_key_path }
  }
  for path in (agenix_bw_temp_files) {
    try { rm -f -- $path }
  }
  setglobal agenix_bw_identity = ''
}

proc agenix_bw_install_cleanup_trap() {
  if (agenix_bw_trap_installed) {
    return
  }
  setglobal agenix_bw_trap_installed = true
  trap --add EXIT { agenix_bw_cleanup }
  trap --add INT { exit 130 }
  trap --add TERM { exit 143 }
  trap --add HUP { exit 129 }
  trap --add QUIT { exit 131 }
}

proc agenix_bw_die(msg) {
  log_die $msg
}

# Longest-prefix mount lookup from /proc/mounts. Kernel escapes whitespace in
# mount points, so paths containing spaces safely fall back to "/".
func agenix_bw_mount_entry(path) {
  var mounts = ''
  try { read --all (&mounts) < /proc/mounts }
  if failed {
    return (null)
  }
  var best = null
  for line in (mounts.split(u'\n')) {
    var fields = line.split(u' ')
    if (len(fields) < 4) {
      continue
    }
    var point = fields[1]
    var matches = false
    if (point === '/') {
      setvar matches = path.startsWith('/')
    } elif (path === point or path.startsWith(point ++ '/')) {
      setvar matches = true
    }
    if (matches) {
      if (best === null) {
        setvar best = { point: point, fstype: fields[2], options: fields[3] }
      } elif (len(point) > len(best.point)) {
        setvar best = { point: point, fstype: fields[2], options: fields[3] }
      }
    }
  }
  return (best)
}

func agenix_bw_mount_has_option(entry, name) {
  if (entry === null) {
    return (false)
  }
  for opt in (entry.options.split(u',')) {
    if (opt === name) {
      return (true)
    }
  }
  return (false)
}

func agenix_bw_forbidden_key_dir(dir) {
  for bad in (['/', '/run', '/dev', '/dev/shm', '/tmp', '/var', '/home']) {
    if (dir === bad) {
      return (true)
    }
  }
  return (false)
}

func agenix_bw_safe_key_dir(dir) {
  var entry = agenix_bw_mount_entry(dir)
  if (entry === null) {
    return (false)
  }
  return (entry.fstype === 'tmpfs')
}

# Re-exec under a systemd user scope with MemorySwapMax=0 so neither the
# identity file nor the process memory can reach unencrypted swap.
proc agenix_bw_swap_guard(caller, ...args) {
  if (get(ENV, 'AGENIX_SWAP_GUARD', '') === '1') {
    return
  }
  var failure = ''
  try { command -v systemd-run >/dev/null }
  if failed {
    setvar failure = 'systemd-run not found'
  }
  var ysh_exe = ''
  if (failure === '') {
    try { setvar ysh_exe = $(command -v ysh) }
    if failed {
      setvar failure = 'cannot locate ysh'
    }
  }
  if (failure === '') {
    try {
      exec systemd-run --user --scope --quiet --setenv=AGENIX_SWAP_GUARD=1 \
        -p MemorySwapMax=0 -- $ysh_exe $caller @[args]
    }
    if failed {
      setvar failure = 'could not enter a no-swap systemd scope'
    }
  }
  if (failure !== '') {
    if (get(ENV, 'AGENIX_REQUIRE_SWAP_GUARD', '') === '1') {
      log_die $"${failure}; refusing to expose the master identity to swap"
    }
    log_warn $"${failure}; the master identity may be swappable"
  }
}

proc agenix_bw_require(name) {
  if (not agenix_bw_command_exists(name)) {
    log_die $"required tool '${name}' not found; run within nix develop, or add it to PATH"
  }
}

func agenix_bw_parent_dir(path) {
  var parts = path.split(u'/')
  if (len(parts) < 2) {
    return ('.')
  }
  var joined = join(parts[0:len(parts) - 1], '/')
  if (joined === '') {
    if (path.startsWith('/')) {
      return ('/')
    }
    return ('.')
  }
  return (joined)
}

func agenix_bw_identity_from(text) {
  for line in (text.split(u'\n')) {
    var candidate = line.trim()
    if (candidate.startsWith('AGE-SECRET-KEY-1') or candidate.startsWith('AGE-PLUGIN-')) {
      return (candidate)
    }
  }
  return ('')
}

func agenix_bw_item_candidates() {
  var item_name = get(ENV, 'BW_MASTER_KEY_ITEM', '')
  if (item_name !== '') {
    return ([item_name])
  }
  # Older vaults used different item names; keep the fallback order stable.
  return ([
    'agenix-master-key',
    'nix-config/agenix-master-key',
    'nix-config/master-key',
    'master-key',
    'nix-config-master-key',
  ])
}

func agenix_bw_primary_identity() {
  var pubkey = ''
  shopt --unset verbose_errexit {
    try { setvar pubkey = $(age-keygen -y $agenix_bw_key_path) }
  }
  if failed {
    return ('')
  }
  return (pubkey)
}

func agenix_bw_session_cache_path() {
  var dir = get(ENV, 'AGENIX_MASTER_KEY_DIR', '')
  if (dir === '') {
    setvar dir = '/run/agenix-master'
  }
  return (dir ++ '/bw-session')
}

func agenix_bw_status_is_unlocked(raw) {
  var obj = null
  shopt --unset verbose_errexit {
    try { json read (&obj) <<< $raw }
  }
  if failed {
    return (false)
  }
  if (type(obj) !== 'Dict') {
    return (false)
  }
  return (get(obj, 'status', '') === 'unlocked')
}

# Cached tokens only survive while the directory is tmpfs-backed, so a plain
# text session never reaches the disk.
proc agenix_bw_save_session(token) {
  if (token === '') {
    return
  }
  var path = agenix_bw_session_cache_path()
  var dir = agenix_bw_parent_dir(path)
  try { test -d $dir }
  if failed {
    log_warn $"cannot cache the Bitwarden session: ${dir} does not exist"
    return
  }
  try { test -L $path }
  if (_error.code === 0) {
    log_warn $"refusing to overwrite the symlinked session cache ${path}"
    return
  }
  var allow_unsafe = get(ENV, 'AGENIX_MASTER_KEY_DIR_ALLOW_UNSAFE', '') === '1'
  if (not agenix_bw_safe_key_dir(dir) and not allow_unsafe) {
    log_warn $"not caching the Bitwarden session in non-tmpfs ${dir}"
    return
  }
  var tmp = ''
  try { setvar tmp = $(mktemp -- $"${dir}/bw-session.XXXXXX") }
  if (tmp === '') {
    log_warn $"cannot create a temporary file in ${dir}"
    return
  }
  try { write -- $token > $tmp }
  if failed {
    rm -f -- $tmp
    log_warn $"cannot write the session cache ${path}"
    return
  }
  chmod 600 $tmp
  try { mv -f -- $tmp $path }
  if failed {
    rm -f -- $tmp
    log_warn $"cannot replace the session cache ${path}"
    return
  }
  chmod 600 $path
}

proc agenix_bw_clear_cached_session() {
  var path = agenix_bw_session_cache_path()
  try { test -e $path }
  if failed {
    return
  }
  try { rm -f -- $path }
  if failed {
    log_warn $"cannot remove the session cache ${path}"
  }
}

# Adopts the cached token only after `bw status` accepts it; anything else is
# dropped so the next unlock rewrites the cache.
proc agenix_bw_load_cached_session() {
  if (agenix_bw_session !== '') {
    return
  }
  var path = agenix_bw_session_cache_path()
  try { test -f $path }
  if failed {
    return
  }
  var cached = ''
  try { read --all (&cached) < $path }
  if failed {
    agenix_bw_clear_cached_session
    return
  }
  setvar cached = cached.trim()
  if (cached === '') {
    agenix_bw_clear_cached_session
    return
  }
  var status = ''
  shopt --unset verbose_errexit {
    try { setvar status = $(env BW_SESSION=$cached bw status --raw) }
  }
  if (agenix_bw_status_is_unlocked(status)) {
    setglobal agenix_bw_session = cached
    setglobal agenix_bw_session_from_env = false
    setglobal agenix_bw_session_from_cache = true
    setglobal ENV.BW_SESSION = agenix_bw_session
    return
  }
  log_info $"cached Bitwarden session in ${path} is no longer valid; removed it" (stream='stderr')
  agenix_bw_clear_cached_session
}

proc agenix_bw_unlock() {
  agenix_bw_require 'bw'
  if (not agenix_bw_stdin_is_tty()) {
    log_die 'a Bitwarden session is required and stdin is not a TTY; set BW_SESSION or run interactively'
  }
  log_info 'unlocking Bitwarden' (stream='stderr')
  var unlocked = ''
  try { setvar unlocked = $(env -u BW_SESSION bw unlock --raw) }
  if failed {
    log_die 'could not unlock Bitwarden; run bw login if you are logged out'
  }
  setvar unlocked = unlocked.trim()
  if (unlocked === '') {
    log_die 'bw unlock returned an empty session key'
  }
  setglobal agenix_bw_session = unlocked
  setglobal agenix_bw_session_from_env = false
  setglobal agenix_bw_session_from_cache = false
  setglobal ENV.BW_SESSION = agenix_bw_session
  agenix_bw_save_session $unlocked
}

proc agenix_bw_login() {
  agenix_bw_require 'bw'
  if (not agenix_bw_stdin_is_tty()) {
    log_die 'not logged in to Bitwarden and stdin is not a TTY; run bw login first'
  }
  log_info 'logging in to Bitwarden' (stream='stderr')
  var unlocked = ''
  try { setvar unlocked = $(env -u BW_SESSION bw login --raw) }
  if failed {
    log_die 'could not log in to Bitwarden'
  }
  setvar unlocked = unlocked.trim()
  if (unlocked === '') {
    log_die 'could not log in to Bitwarden'
  }
  setglobal agenix_bw_session = unlocked
  setglobal agenix_bw_session_from_env = false
  setglobal agenix_bw_session_from_cache = false
  setglobal ENV.BW_SESSION = agenix_bw_session
  agenix_bw_save_session $unlocked
}

proc agenix_bw_session_init() {
  agenix_bw_require 'bw'
  var status_raw = ''
  try { setvar status_raw = $(bw status --raw) }
  if failed {
    log_die 'bw status failed; check that the Bitwarden CLI is configured'
  }

  var status_obj = null
  try { json read (&status_obj) <<< $status_raw }
  if failed {
    log_die 'bw status returned unexpected output'
  }
  if (type (status_obj) !== 'Dict') {
    log_die 'bw status returned unexpected output'
  }

  var state = get(status_obj, 'status', '')
  if (state === 'unauthenticated') {
    agenix_bw_login
    return
  }
  agenix_bw_load_cached_session
  if (agenix_bw_session === '') {
    agenix_bw_unlock
    return
  }
  if (state === 'locked' and not agenix_bw_session_from_cache) {
    agenix_bw_unlock
    return
  }
  if (state !== 'unlocked' and state !== 'locked') {
    log_warn $"unexpected Bitwarden status '${state}'; using the stored session"
  }
  setglobal ENV.BW_SESSION = agenix_bw_session
}

proc agenix_bw_load_item(; candidates) {
  setglobal agenix_bw_item_raw = ''
  setglobal agenix_bw_item_name = ''
  for candidate in (candidates) {
    shopt --unset verbose_errexit {
      try {
        setglobal agenix_bw_item_raw = $(bw get item $candidate --raw 2>/dev/null)
      }
    }
    if (agenix_bw_item_raw !== '') {
      setglobal agenix_bw_item_name = candidate
      return
    }
  }
}

proc agenix_bw_fetch_identity() {
  var candidates = agenix_bw_item_candidates()
  agenix_bw_load_item (candidates)
  var sync_failed = false
  if (agenix_bw_item_raw === '') {
    log_info 'item not found locally; syncing Bitwarden vault (bw sync)'
    try { bw sync >/dev/null }
    if failed {
      setvar sync_failed = true
      log_warn 'bw sync failed; continuing with the local cache'
    }
    agenix_bw_load_item (candidates)
  }
  if (agenix_bw_item_raw === '' and agenix_bw_session_from_env and sync_failed) {
    log_info 'stored BW_SESSION was rejected; unlocking again'
    agenix_bw_unlock
    agenix_bw_load_item (candidates)
  }
  if (agenix_bw_item_raw === '') {
    var tried = join(candidates, ', ')
    log_die $"could not read Bitwarden master key item (tried: ${tried}); run bw sync if it is new"
  }

  var item_name = agenix_bw_item_name
  var item = null
  try { json read (&item) <<< $agenix_bw_item_raw }
  if failed {
    log_die 'bw get item returned unexpected output'
  }
  if (type(item) !== 'Dict') {
    log_die $"Bitwarden item '${item_name}' is ambiguous; use its item ID"
  }

  var field = get(ENV, 'BW_MASTER_KEY_FIELD', 'notes')
  var text = ''
  if (field === 'notes') {
    setvar text = get(item, 'notes', '') or ''
  } elif (field === 'password') {
    var login = get(item, 'login', {}) or {}
    setvar text = get(login, 'password', '') or ''
  } else {
    var fields = get(item, 'fields', []) or []
    for f in (fields) {
      if (get(f, 'name', '') === field) {
        setvar text = get(f, 'value', '') or ''
        break
      }
    }
  }

  var identity = agenix_bw_identity_from(text)
  if (identity === '') {
    log_die $"item '${item_name}' field '${field}' does not contain an age identity"
  }
  setglobal agenix_bw_identity = identity
  setglobal agenix_bw_item_raw = ''
  setvar text = ''
  setvar item = null
}

proc agenix_bw_install_identity() {
  var requested_dir = get(ENV, 'AGENIX_MASTER_KEY_DIR', '')
  var key_dir = requested_dir
  if (key_dir === '') {
    setvar key_dir = '/run/agenix-master'
  }
  if (not key_dir.startsWith('/')) {
    agenix_bw_die $"identity directory must be absolute: ${key_dir}"
  }
  for part in (key_dir.split(u'/')) {
    if (part === '..') {
      agenix_bw_die $"identity directory must not contain '..': ${key_dir}"
    }
  }
  try { test -L $key_dir }
  if (_error.code === 0) {
    agenix_bw_die $"refusing symlinked identity directory: ${key_dir}"
  }

  var canonical = ''
  try { setvar canonical = $(realpath -m -- $key_dir) }
  if failed {
    agenix_bw_die $"cannot resolve identity directory: ${key_dir}"
  }
  setvar key_dir = canonical.trim()
  if (agenix_bw_forbidden_key_dir(key_dir)) {
    agenix_bw_die $"refusing to use system directory as identity storage: ${key_dir}"
  }
  var allow_unsafe = get(ENV, 'AGENIX_MASTER_KEY_DIR_ALLOW_UNSAFE', '') === '1'
  if (not agenix_bw_safe_key_dir(key_dir) and not allow_unsafe) {
    var entry = agenix_bw_mount_entry(key_dir)
    var fstype = 'unknown'
    if (entry !== null) {
      setvar fstype = entry.fstype
    }
    agenix_bw_die $"refusing non-tmpfs identity directory: ${key_dir} (${fstype}); set AGENIX_MASTER_KEY_DIR_ALLOW_UNSAFE=1 to override"
  }

  try { test -d $key_dir }
  if failed {
    try { mkdir -p $key_dir }
    if failed {
      agenix_bw_die $"cannot create ${key_dir}; apply nixos/security/agenix.nix or set AGENIX_MASTER_KEY_DIR"
    }
  }
  try { test -w $key_dir }
  if failed {
    agenix_bw_die $"${key_dir} is not writable; apply nixos/security/agenix.nix or set AGENIX_MASTER_KEY_DIR"
  }
  try { setvar canonical = $(realpath -m -- $key_dir) }
  if failed {
    agenix_bw_die $"cannot resolve identity directory: ${key_dir}"
  }
  setvar key_dir = canonical.trim()
  if (not agenix_bw_safe_key_dir(key_dir) and not allow_unsafe) {
    agenix_bw_die $"refusing non-tmpfs identity directory: ${key_dir}"
  }
  chmod 700 $key_dir

  setglobal agenix_bw_key_dir = key_dir
  setglobal agenix_bw_key_path = agenix_bw_key_dir ++ '/master-key.txt'

  var mount_entry = agenix_bw_mount_entry(key_dir)
  if (not agenix_bw_mount_has_option(mount_entry, 'noswap')) {
    if (key_dir === '/run/agenix-master' and not allow_unsafe) {
      agenix_bw_die $"default identity directory ${key_dir} is not mounted with noswap; apply nixos/security/agenix.nix or set AGENIX_MASTER_KEY_DIR_ALLOW_UNSAFE=1"
    }
    log_warn $"${key_dir} is not mounted with noswap; the master identity may be swappable"
  }

  agenix_bw_install_cleanup_trap

  setglobal agenix_bw_tmp_path = $(mktemp -- $"${agenix_bw_key_dir}/master-key.XXXXXX")
  if (agenix_bw_tmp_path === '') {
    agenix_bw_die $"cannot create a temporary file in ${key_dir}"
  }
  try { write -- $agenix_bw_identity > $agenix_bw_tmp_path }
  if failed {
    agenix_bw_die $"cannot write ${agenix_bw_key_path}"
  }
  chmod 400 $agenix_bw_tmp_path
  mv -f -- $agenix_bw_tmp_path $agenix_bw_key_path
  setglobal agenix_bw_tmp_path = ''
  chmod 400 $agenix_bw_key_path
  setglobal agenix_bw_identity = ''
}

proc agenix_bw_encrypt_file(; source, target, recipient) {
  agenix_bw_install_cleanup_trap
  agenix_bw_require 'age'
  var dir = agenix_bw_parent_dir(target)
  var tmp = $(mktemp -- $"${dir}/.age-tmp.XXXXXX")
  call agenix_bw_temp_files->append(tmp)
  shopt --unset verbose_errexit {
    try { age -r $recipient -o $tmp < $source }
  }
  if failed {
    rm -f -- $tmp
    return 1
  }
  try { mv -f -- $tmp $target }
  if failed {
    rm -f -- $tmp
    return 1
  }
  chmod 644 $target
}

proc agenix_bw_encrypt_text(; text, target, recipient) {
  agenix_bw_install_cleanup_trap
  agenix_bw_require 'age'
  var dir = agenix_bw_parent_dir(target)
  var tmp = $(mktemp -- $"${dir}/.age-tmp.XXXXXX")
  call agenix_bw_temp_files->append(tmp)
  shopt --unset verbose_errexit {
    try { write --end '' -- $text | age -r $recipient -o $tmp }
  }
  if failed {
    rm -f -- $tmp
    return 1
  }
  try { mv -f -- $tmp $target }
  if failed {
    rm -f -- $tmp
    return 1
  }
  chmod 644 $target
}

# --- User SSH key storage (Bitwarden folder nix-config/ssh) ---

const agenix_bw_ssh_folder_name = 'nix-config/ssh'
var agenix_bw_ssh_folder = ''

proc agenix_bw_add_temp(path) {
  agenix_bw_install_cleanup_trap
  call agenix_bw_temp_files->append(path)
}

func agenix_bw_current_hostname() {
  var name = ''
  shopt --unset verbose_errexit {
    try { setvar name = $(hostname 2>/dev/null) }
  }
  return (name.trim())
}

func agenix_bw_bw_stdout(args) {
  var out = ''
  shopt --unset verbose_errexit {
    try { setvar out = $(bw @[args] 2>/dev/null) }
  }
  return (out)
}

func agenix_bw_json_dict(raw) {
  if (raw.trim() === '') {
    return (null)
  }
  var obj = null
  try { json read (&obj) <<< $raw }
  if failed {
    return (null)
  }
  if (type(obj) !== 'Dict') {
    return (null)
  }
  return (obj)
}

func agenix_bw_json_list(raw) {
  if (raw.trim() === '') {
    return ([])
  }
  var obj = null
  try { json read (&obj) <<< $raw }
  if failed {
    return ([])
  }
  if (type(obj) !== 'List') {
    return ([])
  }
  return (obj)
}

func agenix_bw_item_deleted(item) {
  if (item === null) {
    return (false)
  }
  return (get(item, 'deletedDate', null) !== null)
}

# Cached so repeated lookups do not re-list the vault folders.
func agenix_bw_ssh_folder_id() {
  if (agenix_bw_ssh_folder !== '') {
    return (agenix_bw_ssh_folder)
  }
  var raw = agenix_bw_bw_stdout (['list', 'folders', '--raw'])
  for folder in (agenix_bw_json_list(raw)) {
    var folder_name = get(folder, 'name', '') or ''
    if (folder_name === agenix_bw_ssh_folder_name) {
      setglobal agenix_bw_ssh_folder = get(folder, 'id', '') or ''
      return (agenix_bw_ssh_folder)
    }
  }
  return ('')
}

proc agenix_bw_ssh_ensure_folder() {
  if (agenix_bw_ssh_folder_id() !== '') {
    return
  }
  agenix_bw_require 'base64'
  var created_raw = ''
  shopt --unset verbose_errexit {
    try {
      setvar created_raw = $(json write ({ name: agenix_bw_ssh_folder_name }) | base64 -w0 | bw create folder --raw)
    }
  }
  var created = agenix_bw_json_dict(created_raw)
  if (created === null) {
    agenix_bw_die $"cannot create the Bitwarden folder ${agenix_bw_ssh_folder_name}"
  }
  setglobal agenix_bw_ssh_folder = get(created, 'id', '') or ''
  if (agenix_bw_ssh_folder === '') {
    agenix_bw_die $"Bitwarden returned no id for the folder ${agenix_bw_ssh_folder_name}"
  }
  log_info $"created Bitwarden folder ${agenix_bw_ssh_folder_name}"
}

func agenix_bw_ssh_folder_item(hostname) {
  var folder = agenix_bw_ssh_folder_id()
  if (folder === '') {
    return (null)
  }
  var listed = agenix_bw_json_list(agenix_bw_bw_stdout ([
    'list', 'items', '--folderid', folder, '--search', hostname, '--raw'
  ]))
  for candidate in (listed) {
    var candidate_name = get(candidate, 'name', '') or ''
    if (candidate_name !== hostname) {
      continue
    }
    if (agenix_bw_item_deleted(candidate)) {
      continue
    }
    var item_id = get(candidate, 'id', '') or ''
    if (item_id === '') {
      return (candidate)
    }
    var full = agenix_bw_json_dict(agenix_bw_bw_stdout (['get', 'item', item_id, '--raw']))
    if (full !== null) {
      if (agenix_bw_item_deleted(full)) {
        continue
      }
      return (full)
    }
    return (candidate)
  }
  return (null)
}

func agenix_bw_ssh_lookup_item(hostname) {
  var item = agenix_bw_ssh_folder_item(hostname)
  if (item !== null) {
    return (item)
  }
  # Names carrying the folder path predate folder-scoped lookup; a bare
  # hostname only resolves when bw finds exactly one match.
  for name in (['nix-config/ssh/' ++ hostname, 'ssh/' ++ hostname, hostname]) {
    var legacy = agenix_bw_json_dict(agenix_bw_bw_stdout (['get', 'item', name, '--raw']))
    if (legacy === null) {
      continue
    }
    if (agenix_bw_item_deleted(legacy)) {
      continue
    }
    var legacy_name = get(legacy, 'name', '') or ''
    if (legacy_name !== hostname and legacy_name !== name) {
      continue
    }
    return (legacy)
  }
  return (null)
}

func agenix_bw_ssh_find_item(hostname) {
  var item = agenix_bw_ssh_lookup_item(hostname)
  if (item !== null) {
    return (item)
  }
  log_info 'SSH key item not found locally; syncing Bitwarden vault (bw sync)'
  shopt --unset verbose_errexit {
    try { bw sync >/dev/null }
  }
  return (agenix_bw_ssh_lookup_item(hostname))
}

func agenix_bw_ssh_pem_private_key(text) {
  var lines = []
  var inside = false
  for line in (text.split(u'\n')) {
    var stripped = line.trim()
    if (stripped.startsWith('-----BEGIN ') and stripped.contains('PRIVATE KEY-----')) {
      setvar inside = true
    }
    if (inside) {
      call lines->append(stripped)
    }
    if (inside and stripped.startsWith('-----END ') and stripped.contains('PRIVATE KEY-----')) {
      break
    }
  }
  if (len(lines) === 0) {
    return ('')
  }
  return (join(lines, u'\n') ++ u'\n')
}

# Bitwarden SSH Key items (type 5) carry sshKey.privateKey; older entries
# stored the PEM block in notes as a Secure Note (type 2).
func agenix_bw_ssh_private_key(item) {
  var kind = get(item, 'type', 0) or 0
  if (kind === 5) {
    var ssh_key = get(item, 'sshKey', null)
    if (ssh_key !== null) {
      var private = get(ssh_key, 'privateKey', '') or ''
      if (private.trim() !== '') {
        return (private)
      }
    }
  }
  var notes = get(item, 'notes', '') or ''
  return (agenix_bw_ssh_pem_private_key(notes))
}

func agenix_bw_ssh_item_public_key(item) {
  var kind = get(item, 'type', 0) or 0
  if (kind !== 5) {
    return ('')
  }
  var ssh_key = get(item, 'sshKey', null)
  if (ssh_key === null) {
    return ('')
  }
  var public = get(ssh_key, 'publicKey', '') or ''
  return (public.trim())
}

func agenix_bw_ssh_normalize_private(text) {
  return (text.trim() ++ u'\n')
}

# The key reaches ssh-keygen over a pipe, so it never lands on disk.
func agenix_bw_ssh_derive_public_key(private_text) {
  var derived = ''
  shopt --unset verbose_errexit {
    try {
      setvar derived = $(write --end '' -- $private_text | ssh-keygen -y -f /dev/stdin 2>/dev/null)
    }
  }
  return (derived.trim())
}

func agenix_bw_ssh_fingerprint(key_path) {
  var out = ''
  shopt --unset verbose_errexit {
    try { setvar out = $(ssh-keygen -lf $key_path 2>/dev/null) }
  }
  var fields = out.trim().split(u' ')
  if (len(fields) < 2) {
    return ('')
  }
  return (fields[1])
}
