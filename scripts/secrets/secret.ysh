#!/usr/bin/env ysh
#
# Unified CLI for the agenix-rekey secret workflows.
#
# Usage:
#   ysh scripts/secrets/secret.ysh rekey [agenix args...]
#   ysh scripts/secrets/secret.ysh edit <file>
#   ysh scripts/secrets/secret.ysh apply-staging [--dry-run] [--no-rekey]
#   ysh scripts/secrets/secret.ysh ssh-restore [hostname] [--file <path>] [--force]
#   ysh scripts/secrets/secret.ysh ssh-backup [hostname] [--file <path>] [--force]
#   ysh scripts/secrets/secret.ysh doctor
#
# The Bitwarden master identity is reused from agenix-bw-lib.ysh. A missing
# BW_SESSION or a locked vault triggers `bw unlock` only when stdin is a TTY;
# non-interactive runs must pass BW_SESSION. Missing tools are reported with
# the command name before any secret work starts.

source $_this_dir/agenix-bw-lib.ysh

agenix_bw_swap_guard $0 @[ARGV]

const STAGING_DIR = '.secrets-staging'
const MASTER_DIR = 'secrets/master'
const AGENIX_MODULE = 'lib/agenix.nix'
const HOME_AGENIX_MODULE = 'home/agenix.nix'

proc usage() {
  echo 'usage: ysh scripts/secrets/secret.ysh <command> [args...]'
  echo ''
  echo 'commands:'
  echo '  rekey [agenix args...]                           Run agenix rekey with the master identity'
  echo '  edit <file>                                      Edit a master secret file'
  echo '  apply-staging [--dry-run] [--no-rekey]           Encrypt .secrets-staging files and rekey'
  echo '  ssh-restore [hostname] [--file <path>] [--force] Restore an SSH private key from Bitwarden'
  echo '  ssh-backup [hostname] [--file <path>] [--force]  Back up an SSH private key to Bitwarden'
  echo '  doctor                                           Check tools, master identity, Bitwarden, and staging'
}

proc die(msg) {
  log_die $msg
}

func is_safe_relative(path) {
  if (path === '' or path.startsWith('/')) {
    return (false)
  }
  for part in (path.split(u'/')) {
    if (part === '..') {
      return (false)
    }
  }
  return (true)
}

func parent_dir(path) {
  var parts = path.split(u'/')
  if (len(parts) < 2) {
    return ('.')
  }
  var joined = join(parts[0:len(parts) - 1], '/')
  if (joined === '') {
    if (path.startsWith('/')) {
      return ('/')
    }
    return ('.')
  }
  return (joined)
}

func file_exists(path) {
  try { test -f $path }
  return (_error.code === 0)
}

func read_file(path) {
  var content = ''
  try { read --all (&content) < $path } 2>/dev/null
  if failed {
    return (null)
  }
  return (content)
}

func count_nonempty_lines(text) {
  var count = 0
  for line in (text.split(u'\n')) {
    if (line !== '') {
      setvar count += 1
    }
  }
  return (count)
}

func master_recipient_pubkey(path) {
  var content = read_file(path)
  if (content === null) {
    return ('')
  }
  for line in (content.split(u'\n')) {
    if (line.trim().startsWith('#')) {
      continue
    }
    if (line.contains('pubkey')) {
      var parts = line.split(u'"')
      if (len(parts) >= 2 and parts[1].startsWith('age1')) {
        return (parts[1])
      }
    }
  }
  return ('')
}

func ssh_pubkey_core(line) {
  var fields = line.trim().split(u' ')
  if (len(fields) < 2) {
    return (line.trim())
  }
  return (fields[0] ++ ' ' ++ fields[1])
}

# A symlinked .pub would keep pointing at the old target, so only a directly
# written keypair counts as already in place.
func ssh_key_pair_matches(key_path, pub_path, derived) {
  for path in ([key_path, pub_path]) {
    try { test -L $path }
    if (_error.code === 0) {
      return (false)
    }
  }
  try { test -f $pub_path }
  if (_error.code !== 0) {
    return (false)
  }
  var existing = read_file(pub_path)
  if (existing === null) {
    return (false)
  }
  return (ssh_pubkey_core(existing) === ssh_pubkey_core(derived))
}

# Only the home-manager block rekeys home secrets, so the top-level
# hostPubkey (the machine host key) must not be used for comparison.
func host_home_ssh_pubkey(hostname) {
  if (hostname === '') {
    return ('')
  }
  var path = 'hosts/' ++ hostname ++ '/default.nix'
  try { test -f $path }
  if (_error.code !== 0) {
    return ('')
  }
  var content = read_file(path)
  if (content === null) {
    return ('')
  }
  var in_home_block = false
  for line in (content.split(u'\n')) {
    var stripped = line.trim()
    if (stripped.startsWith('#')) {
      continue
    }
    if (stripped.contains('home-manager.users')) {
      setvar in_home_block = true
      continue
    }
    if (not in_home_block or not stripped.contains('age.rekey.hostPubkey')) {
      continue
    }
    for part in (stripped.split(u'"')) {
      if (part.startsWith('ssh-ed25519 ')) {
        return (part)
      }
    }
  }
  return ('')
}

func valid_hostname(name) {
  return (name ~ '^[A-Za-z0-9][A-Za-z0-9._-]*$')
}

# Bitwarden reads the base64 payload from stdin; passing it as an argument
# would expose the private key in ps output.
func ssh_submit_item(payload) {
  var encoded = ''
  shopt --unset verbose_errexit {
    try { setvar encoded = $(json write (payload) | base64 -w0) }
  }
  if (encoded === '') {
    return (false)
  }
  var ok = false
  shopt --unset verbose_errexit {
    try { write --end '' -- $encoded | bw create item >/dev/null }
    if (_error.code === 0) {
      setvar ok = true
    }
  }
  return (ok)
}

# Without --permanent, Bitwarden only moves the item to the Trash.
func ssh_trash_item(item_id) {
  var ok = false
  shopt --unset verbose_errexit {
    try { bw delete item $item_id >/dev/null 2>&1 }
    if (_error.code === 0) {
      setvar ok = true
    }
  }
  return (ok)
}

# Snapshots path to path.bak through a temp file so the backup appears with
# its final mode in one rename. Unreadable files are renamed instead, since
# their contents cannot be copied.
proc backup_file(path, mode) {
  var backup_path = path ++ '.bak'
  try { test -L $backup_path }
  if (_error.code === 0) {
    die $"refusing to write through symlinked backup ${backup_path}"
  }
  try { test -d $backup_path }
  if (_error.code === 0) {
    die $"refusing to replace directory ${backup_path}"
  }
  var dir = parent_dir(path)
  var tmp = ''
  try { setvar tmp = $(mktemp -- $"${dir}/.backup.XXXXXX") }
  if (tmp === '') {
    die $"cannot create a temporary backup in ${dir}"
  }
  agenix_bw_add_temp $tmp
  try { cp -f -- $path $tmp 2>/dev/null }
  if failed {
    rm -f -- $tmp
    log_warn $"cannot copy ${path}; moving it to ${backup_path} instead"
    try { mv -f -- $path $backup_path }
    if failed {
      die $"cannot back up ${path} to ${backup_path}"
    }
    chmod $mode $backup_path
    log_info $"backed up ${path} to ${backup_path}"
    return
  }
  chmod $mode $tmp
  try { mv -f -- $tmp $backup_path }
  if failed {
    die $"cannot install ${backup_path}"
  }
  log_info $"backed up ${path} to ${backup_path}"
}

func staging_target(file) {
  var rel = file
  if (rel.startsWith(STAGING_DIR ++ '/')) {
    setvar rel = rel[len(STAGING_DIR ++ '/'):]
  }
  if (rel.startsWith(MASTER_DIR ++ '/')) {
    setvar rel = rel[len(MASTER_DIR ++ '/'):]
  }
  if (not is_safe_relative(rel)) {
    return (null)
  }
  if (rel.endsWith('.age')) {
    return (MASTER_DIR ++ '/' ++ rel)
  }
  return (MASTER_DIR ++ '/' ++ rel ++ '.age')
}

proc shred_staged(file) {
  try { shred -u -- $file }
  if failed {
    try { rm -f -- $file }
  }
  if failed {
    log_warn $"could not remove staged file ${file}"
  }
}

proc agenix_with_identity(; args; tmpdir='') {
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  var pubkey = agenix_bw_primary_identity()
  if (pubkey === '') {
    die 'cannot derive the master recipient from the Bitwarden key'
  }
  var agenix_env = [
    'AGENIX_MASTER_KEY_FILE=' ++ agenix_bw_key_path,
    'AGENIX_REKEY_PRIMARY_IDENTITY=' ++ pubkey,
  ]
  if (tmpdir !== '') {
    call agenix_env->append('TMPDIR=' ++ tmpdir)
  }
  env @[agenix_env] $agenix_cmd @[args]
}

proc run_with_agenix(; args; key_dir_tmpdir=false) {
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  agenix_bw_require 'bw'
  agenix_bw_require 'age-keygen'
  agenix_bw_require $agenix_cmd
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity
  if (key_dir_tmpdir) {
    agenix_with_identity (args; tmpdir=agenix_bw_key_dir)
  } else {
    agenix_with_identity (args)
  }
}

proc rekey(; args) {
  shopt --unset verbose_errexit
  try { git add -N -- secrets/ 2>/dev/null }
  try { git add -N -- nixos/networking/nebula/ 2>/dev/null }
  try { git add -N -- hosts/*/nebula.crt 2>/dev/null }
  run_with_agenix (['rekey'] ++ args)
  try { git add -u -- secrets/rekeyed/ 2>/dev/null }
  try { git add -N -- secrets/ 2>/dev/null }
}

proc edit(; args) {
  if (len(args) !== 1) {
    usage
    exit 2
  }
  var file = args[0]
  if (not file_exists(file)) {
    die $"secret file not found: ${file}"
  }
  shopt --unset verbose_errexit
  # Keep cleartext edit scratch files inside the noswap tmpfs.
  run_with_agenix (['edit', file]; key_dir_tmpdir=true)
}

proc apply_staging(; args) {
  var dry_run = false
  var no_rekey = false
  for arg in (args) {
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--dry-run') { setvar dry_run = true }
      ('--no-rekey') { setvar no_rekey = true }
      (else) {
        log_error $"unknown argument: ${arg}"
        exit 2
      }
    }
  }

  try { test -d $STAGING_DIR }
  if failed {
    log_info $"no ${STAGING_DIR} directory; nothing to apply"
    return
  }

  var find_out = ''
  try { setvar find_out = $(find $STAGING_DIR -type f -not -name '*~' -not -name '*.swp' -not -name '*.swo') }
  if failed {
    die $"cannot scan ${STAGING_DIR}"
  }

  var plan = []
  var seen = {}
  for file in (find_out.split(u'\n')) {
    if (file === '') {
      continue
    }
    var target = staging_target(file)
    if (target === null) {
      die $"unsafe staging path: ${file}"
    }
    if (target in seen) {
      var prior = seen[target]
      die $"both ${prior} and ${file} map to ${target}"
    }
    setvar seen[target] = file
    call plan->append({ source: file, target: target })
  }
  if (len(plan) === 0) {
    log_info $"no staged secrets in ${STAGING_DIR}"
    return
  }

  if (dry_run) {
    for item in (plan) {
      var plan_target = item.target
      var plan_source = item.source
      log_info $"plan: ${plan_target} <- ${plan_source}"
    }
    var plan_count = len(plan)
    log_info $"dry run: ${plan_count} staged file(s)"
    return
  }

  shopt --unset verbose_errexit
  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = agenix_bw_primary_identity()
  if (recipient === '') {
    die 'cannot derive the master recipient from the Bitwarden key'
  }

  var written = 0
  var failed_count = 0
  for item in (plan) {
    var item_source = item.source
    var item_target = item.target
    mkdir -p $[parent_dir(item_target)]
    try { agenix_bw_encrypt_file (item_source, item_target, recipient) }
    if failed {
      log_error $"failed to encrypt ${item_target}"
      setvar failed_count += 1
      continue
    }
    log_ok $"encrypted ${item_target}"
    setvar written += 1
    shred_staged $item_source
  }

  try { find $STAGING_DIR -mindepth 1 -type d -empty -delete }
  if failed {
    log_warn $"could not prune empty directories under ${STAGING_DIR}"
  }

  var staged_left = ''
  try { setvar staged_left = $(find $STAGING_DIR -type f 2>/dev/null) }
  if failed {
    setvar staged_left = ''
  }
  if (staged_left !== '') {
    log_warn $"staged plaintext remains in ${STAGING_DIR}"
    setvar failed_count += 1
  } else {
    try { rmdir $STAGING_DIR 2>/dev/null }
  }

  if (written > 0 and not no_rekey) {
    var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
    agenix_bw_require $agenix_cmd
    try { git add -N -- secrets/ >/dev/null 2>&1 }
    try { agenix_with_identity (['rekey']) }
    if failed {
      log_error 'agenix rekey failed; rekeyed secrets were not staged'
      exit 1
    }
    try { git add -A -- secrets/rekeyed/ }
    if failed {
      log_warn 'could not stage secrets/rekeyed/'
    }
  }
  if (failed_count > 0) {
    exit 1
  }
}

proc ssh_restore(; args) {
  var force = false
  var hostname = ''
  var key_path = ''
  var i = 0
  while (i < len(args)) {
    var arg = args[i]
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--force') { setvar force = true }
      ('--file') {
        setvar i += 1
        if (i >= len(args)) {
          log_error '--file requires a path'
          exit 2
        }
        setvar key_path = args[i]
      }
      (else) {
        if (arg.startsWith('-')) {
          log_error $"unknown option: ${arg}"
          exit 2
        }
        if (hostname !== '') {
          log_error 'ssh-restore accepts at most one hostname'
          exit 2
        }
        setvar hostname = arg
      }
    }
    setvar i += 1
  }
  if (hostname === '') {
    setvar hostname = agenix_bw_current_hostname()
  }
  if (hostname === '') {
    die 'cannot determine the hostname; pass one explicitly'
  }
  if (not valid_hostname(hostname)) {
    die $"invalid hostname: ${hostname}"
  }
  var home = get(ENV, 'HOME', '')
  if (key_path === '') {
    if (home === '') {
      die 'HOME is unset'
    }
    setvar key_path = home ++ '/.ssh/id_ed25519'
  }
  var is_default_target = (home !== '' and key_path === home ++ '/.ssh/id_ed25519')

  shopt --unset verbose_errexit
  agenix_bw_require 'bw'
  agenix_bw_require 'ssh-keygen'
  agenix_bw_session_init
  var item = agenix_bw_ssh_find_item(hostname)
  if (item === null) {
    die $"no Bitwarden SSH key item for ${hostname} under ${agenix_bw_ssh_folder_name}; run just secret-ssh-backup on ${hostname}"
  }
  var private_text = agenix_bw_ssh_private_key(item)
  if (private_text === '') {
    die $"Bitwarden item for ${hostname} does not contain an SSH private key"
  }
  setvar private_text = agenix_bw_ssh_normalize_private(private_text)
  var derived = agenix_bw_ssh_derive_public_key(private_text)
  if (derived === '') {
    die $"the Bitwarden item for ${hostname} is not an unencrypted SSH private key"
  }

  var ssh_dir = parent_dir(key_path)
  var pub_path = key_path ++ '.pub'

  try { test -L $ssh_dir }
  if (_error.code === 0) {
    die $"refusing symlinked SSH directory: ${ssh_dir}"
  }
  try { test -d $ssh_dir }
  var ssh_dir_existed = (_error.code === 0)
  try { mkdir -p $ssh_dir }
  if failed {
    die $"cannot create ${ssh_dir}"
  }
  # A custom --file may target a shared directory such as /tmp; only tighten
  # permissions when the directory is new or is the default ~/.ssh.
  if (not ssh_dir_existed or is_default_target) {
    chmod 700 $ssh_dir
  }

  # Legacy sops-nix installs symlinked the key into /run/secrets; replace the
  # link instead of writing through it.
  try { test -L $key_path }
  if (_error.code === 0) {
    log_info $"removing legacy symlink ${key_path}"
    try { rm -f -- $key_path }
    if failed {
      die $"cannot remove ${key_path}"
    }
  }
  for target in ([key_path, pub_path]) {
    try { test -d $target }
    if (_error.code === 0) {
      die $"${target} is a directory; remove it before restoring"
    }
  }
  var overwriting = false
  var replacing = false
  try { test -f $key_path }
  if (_error.code === 0) {
    setvar replacing = true
    var current = read_file(key_path)
    var unreadable = (current === null)
    var differs = unreadable
    if (not unreadable) {
      setvar differs = current.trim() !== private_text.trim()
    }
    if (differs and not force) {
      if (not agenix_bw_stdin_is_tty()) {
        if (unreadable) {
          die $"cannot read the existing ${key_path}; pass --force to replace it"
        }
        die $"${key_path} already exists with different content; pass --force to replace it"
      }
      if (unreadable) {
        log_warn $"cannot read the existing ${key_path}"
      } else {
        log_warn $"${key_path} differs from Bitwarden ${agenix_bw_ssh_folder_name}/${hostname}"
      }
      var question = $"Overwrite ${key_path} with Bitwarden ${agenix_bw_ssh_folder_name}/${hostname}?"
      if (not agenix_bw_confirm(question)) {
        log_die $"aborted; ${key_path} was left unchanged"
      }
    }
    if (differs) {
      setvar overwriting = true
    } elif (not force and ssh_key_pair_matches(key_path, pub_path, derived)) {
      chmod 600 $key_path
      chmod 644 $pub_path
      log_ok $"${key_path} already matches ${agenix_bw_ssh_folder_name}/${hostname}"
      return
    }
  }
  if (overwriting) {
    log_warn $"overwriting ${key_path}"
  }
  if (replacing) {
    backup_file $key_path 600
  }
  try { test -L $pub_path }
  var pub_is_symlink = (_error.code === 0)
  try { test -f $pub_path }
  if (_error.code === 0 and not pub_is_symlink) {
    backup_file $pub_path 644
  }

  var tmp = ''
  try { setvar tmp = $(mktemp -- $"${ssh_dir}/.id_ed25519.XXXXXX") }
  if (tmp === '') {
    die $"cannot create a temporary key in ${ssh_dir}"
  }
  agenix_bw_add_temp $tmp
  try { write --end '' -- $private_text > $tmp }
  if failed {
    die $"cannot write a temporary private key in ${ssh_dir}"
  }
  chmod 600 $tmp
  try { mv -f -- $tmp $key_path }
  if failed {
    die $"cannot install ${key_path}"
  }
  chmod 600 $key_path

  var stored_public = agenix_bw_ssh_item_public_key(item)
  var public_text = derived
  if (stored_public !== '') {
    if (ssh_pubkey_core(stored_public) === ssh_pubkey_core(derived)) {
      setvar public_text = stored_public
    } else {
      log_warn $"the stored public key for ${hostname} does not match the private key; using the derived key"
    }
  }
  var pub_tmp = ''
  try { setvar pub_tmp = $(mktemp -- $"${ssh_dir}/.id_ed25519.pub.XXXXXX") }
  if (pub_tmp === '') {
    die $"cannot create a temporary public key in ${ssh_dir}"
  }
  agenix_bw_add_temp $pub_tmp
  try { write -- $public_text > $pub_tmp }
  if failed {
    die $"cannot write ${pub_path}"
  }
  chmod 644 $pub_tmp
  try { mv -f -- $pub_tmp $pub_path }
  if failed {
    die $"cannot install ${pub_path}"
  }
  chmod 644 $pub_path
  log_ok $"restored ${key_path} from ${agenix_bw_ssh_folder_name}/${hostname}"

  var expected = host_home_ssh_pubkey(hostname)
  if (expected === '') {
    log_info $"hosts/${hostname}/default.nix has no home-manager age.rekey.hostPubkey to compare"
  } elif (ssh_pubkey_core(expected) !== ssh_pubkey_core(derived)) {
    log_warn $"the restored key does not match the home-manager age.rekey.hostPubkey in hosts/${hostname}/default.nix"
  } else {
    log_ok 'the restored key matches the home-manager age.rekey.hostPubkey'
  }

  if (is_default_target and agenix_bw_current_hostname() === hostname) {
    var units = []
    for unit in (['agenix.service', 'import-gpg-key.service']) {
      try { systemctl --user cat $unit >/dev/null 2>&1 }
      if (_error.code === 0) {
        call units->append(unit)
      }
    }
    for unit in (units) {
      try { systemctl --user restart $unit }
      if failed {
        log_warn $"could not restart ${unit}; restart it manually"
      } else {
        log_ok $"restarted ${unit}"
      }
    }
  }
}

proc ssh_backup(; args) {
  var force = false
  var hostname = ''
  var key_path = ''
  var i = 0
  while (i < len(args)) {
    var arg = args[i]
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--force') { setvar force = true }
      ('--file') {
        setvar i += 1
        if (i >= len(args)) {
          log_error '--file requires a path'
          exit 2
        }
        setvar key_path = args[i]
      }
      (else) {
        if (arg.startsWith('-')) {
          log_error $"unknown option: ${arg}"
          exit 2
        }
        if (hostname !== '') {
          log_error 'ssh-backup accepts at most one hostname'
          exit 2
        }
        setvar hostname = arg
      }
    }
    setvar i += 1
  }
  var home = get(ENV, 'HOME', '')
  if (key_path === '') {
    if (home === '') {
      die 'HOME is unset'
    }
    setvar key_path = home ++ '/.ssh/id_ed25519'
  }
  if (hostname === '') {
    setvar hostname = agenix_bw_current_hostname()
  }
  if (hostname === '') {
    die 'cannot determine the hostname; pass one explicitly'
  }
  if (not valid_hostname(hostname)) {
    die $"invalid hostname: ${hostname}"
  }

  shopt --unset verbose_errexit
  try { test -e $key_path }
  if (_error.code !== 0) {
    die $"SSH private key not found or a broken symlink: ${key_path}"
  }
  try { test -f $key_path }
  if (_error.code !== 0) {
    die $"not a regular file: ${key_path}"
  }
  var private_text = read_file(key_path)
  if (private_text === null) {
    die $"cannot read ${key_path}"
  }
  setvar private_text = agenix_bw_ssh_normalize_private(private_text)

  agenix_bw_require 'bw'
  agenix_bw_require 'ssh-keygen'
  agenix_bw_require 'base64'
  agenix_bw_session_init
  var public_text = agenix_bw_ssh_derive_public_key(private_text)
  if (public_text === '') {
    die $"cannot derive a public key from ${key_path}; is it an unencrypted private key?"
  }
  var fingerprint = agenix_bw_ssh_fingerprint(key_path)
  if (fingerprint === '') {
    log_warn $"cannot read the SHA256 fingerprint of ${key_path}"
  }

  var existing = agenix_bw_ssh_folder_item(hostname)
  if (existing === null) {
    setvar existing = agenix_bw_ssh_find_item(hostname)
  }
  var folder = agenix_bw_ssh_folder_id()
  if (existing !== null) {
    var existing_private = agenix_bw_ssh_private_key(existing)
    var same_key = (existing_private.trim() !== '' and existing_private.trim() === private_text.trim())
    var in_ssh_folder = (folder !== '' and (get(existing, 'folderId', '') or '') === folder)
    if (same_key) {
      if (in_ssh_folder) {
        log_ok $"Bitwarden item ${agenix_bw_ssh_folder_name}/${hostname} already matches ${key_path}"
        return
      }
      log_info $"moving Bitwarden item ${hostname} into ${agenix_bw_ssh_folder_name}"
    } else {
      if (not force) {
        if (not agenix_bw_stdin_is_tty()) {
          die $"Bitwarden item ${agenix_bw_ssh_folder_name}/${hostname} already exists with different content; pass --force to overwrite it"
        }
        log_warn $"Bitwarden item ${agenix_bw_ssh_folder_name}/${hostname} already exists with different content"
        var question = $"Overwrite Bitwarden item ${agenix_bw_ssh_folder_name}/${hostname} with ${key_path}?"
        if (not agenix_bw_confirm(question)) {
          log_die 'aborted; the Bitwarden item was left unchanged'
        }
      }
      log_warn $"replacing Bitwarden item ${agenix_bw_ssh_folder_name}/${hostname}"
    }
  }

  agenix_bw_ssh_ensure_folder
  setvar folder = agenix_bw_ssh_folder_id()

  var old_item_id = ''
  var organization_id = null
  var collection_ids = null
  if (existing !== null) {
    setvar old_item_id = get(existing, 'id', '') or ''
    setvar organization_id = get(existing, 'organizationId', null)
    setvar collection_ids = get(existing, 'collectionIds', null)
  }

  # Bitwarden assigns item ids, so a replacement is always a create; the old
  # item is trashed only after the new key is safely stored.
  var ssh_payload = {
    organizationId: organization_id,
    collectionIds: collection_ids,
    folderId: folder,
    type: 5,
    name: hostname,
    notes: null,
    favorite: false,
    reprompt: 0,
    sshKey: {
      privateKey: private_text,
      publicKey: public_text,
      keyFingerprint: fingerprint,
    },
  }
  var stored_as_note = false
  if (not ssh_submit_item (ssh_payload)) {
    log_warn 'Bitwarden rejected the SSH key item; retrying as a secure note'
    setvar stored_as_note = true
    var note_payload = {
      organizationId: organization_id,
      collectionIds: collection_ids,
      folderId: folder,
      type: 2,
      name: hostname,
      notes: private_text,
      favorite: false,
      reprompt: 0,
      secureNote: { type: 0 },
    }
    if (not ssh_submit_item (note_payload)) {
      die $"cannot store ${key_path} in Bitwarden folder ${agenix_bw_ssh_folder_name}"
    }
  }

  if (old_item_id !== '') {
    if (ssh_trash_item(old_item_id)) {
      log_info $"moved previous Bitwarden item (${old_item_id}) to the Trash"
    } else {
      log_warn $"could not move previous Bitwarden item (${old_item_id}) to the Trash; delete it manually"
    }
  }
  if (stored_as_note) {
    log_ok $"stored ${key_path} in Bitwarden as a secure note ${agenix_bw_ssh_folder_name}/${hostname}"
  } else {
    log_ok $"stored ${key_path} in Bitwarden as ${agenix_bw_ssh_folder_name}/${hostname}"
  }
}

proc doctor(; args) {
  if (len(args) > 0) {
    usage
    exit 2
  }

  shopt --unset verbose_errexit
  var errors = 0
  var warnings = 0
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')

  var session_detail = 'BW_SESSION unset'
  if (get(ENV, 'BW_SESSION', '') !== '') {
    setvar session_detail = 'BW_SESSION set'
  }
  var bw_verdict = 'ok'
  var bw_detail = ''
  var bw_status = ''
  try { setvar bw_status = $(bw status --raw) }
  var status_obj = null
  if (bw_status !== '') {
    try { json read (&status_obj) <<< $bw_status }
  }
  if (bw_status === '') {
    setvar bw_verdict = 'warn'
    setvar bw_detail = $"cannot read bw status (${session_detail})"
  } elif (status_obj === null or type (status_obj) !== 'Dict') {
    setvar bw_verdict = 'warn'
    setvar bw_detail = $"unexpected bw status output (${session_detail})"
  } else {
    var state = get(status_obj, 'status', 'unknown')
    if (state === 'unauthenticated') {
      setvar bw_verdict = 'error'
      setvar bw_detail = $"not logged in; run bw login (${session_detail})"
    } elif (state === 'locked') {
      if (agenix_bw_command_exists('bw') and agenix_bw_stdin_is_tty()) {
        agenix_bw_unlock
        echo '' >&2
        setvar bw_detail = 'unlocked (interactive prompt)'
      } else {
        setvar bw_verdict = 'warn'
        setvar bw_detail = 'locked (non-interactive; set BW_SESSION)'
      }
    } elif (state === 'unlocked' and agenix_bw_session_from_env) {
      setvar bw_detail = 'unlocked (BW_SESSION)'
    } else {
      setvar bw_detail = $"${state} (${session_detail})"
    }
  }

  log_section 'Tools'
  var required_tools = ['bw', 'age', 'age-keygen', agenix_cmd, 'git', 'ssh-keygen', 'shred']
  var missing_tools = []
  for tool in (required_tools) {
    if (not agenix_bw_command_exists(tool)) {
      call missing_tools->append(tool)
    }
  }
  if (len(missing_tools) === 0) {
    var tool_list = join(required_tools, ', ')
    report_ok 'CLI tools' $tool_list
  } else {
    for tool in (missing_tools) {
      if (tool === 'shred') {
        report_warn $tool 'not found; staged plaintext falls back to rm -f'
        setvar warnings += 1
      } else {
        report_error $tool 'not found on PATH (run within nix develop)'
        setvar errors += 1
      }
    }
  }

  log_section 'Master Identity'
  var master_dir = get(ENV, 'AGENIX_MASTER_KEY_DIR', '/run/agenix-master')
  try { test -d $master_dir }
  if failed {
    report_warn 'Key directory' $"${master_dir} is absent; apply nixos/security/agenix.nix"
    setvar warnings += 1
  } else {
    var dir_mode = ''
    try { setvar dir_mode = $(stat -L -c %a $master_dir) }
    var mount_entry = agenix_bw_mount_entry(master_dir)
    var stale_files = []
    var stale_out = ''
    try { setvar stale_out = $(find $master_dir -maxdepth 1 -type f -name 'master-key*' 2>/dev/null) }
    for file in (stale_out.split(u'\n')) {
      if (file !== '') {
        call stale_files->append(file)
      }
    }

    if (dir_mode === '') {
      report_warn 'Key directory' $"cannot stat ${master_dir}"
      setvar warnings += 1
    } elif (dir_mode !== '700') {
      report_warn 'Key directory' $"${master_dir} mode is ${dir_mode}, expected 700"
      setvar warnings += 1
    } elif (mount_entry === null) {
      report_warn 'Key directory' $"cannot determine the filesystem for ${master_dir}"
      setvar warnings += 1
    } elif (mount_entry.fstype !== 'tmpfs') {
      var mount_fs = mount_entry.fstype
      report_error 'Key directory' $"${master_dir} is on ${mount_fs}, not tmpfs"
      setvar errors += 1
    } elif (not agenix_bw_mount_has_option(mount_entry, 'noswap')) {
      report_warn 'Key directory' $"${master_dir} is not mounted with noswap"
      setvar warnings += 1
    } elif (mount_entry.point !== master_dir) {
      report_warn 'Key directory' $"${master_dir} is not a dedicated mount point"
      setvar warnings += 1
    } elif (len(stale_files) > 0) {
      var stale_list = join(stale_files, ', ')
      report_warn 'Key directory' $"stale identity file(s): ${stale_list}"
      setvar warnings += 1
    } else {
      report_ok 'Key directory' $"${master_dir} (noswap tmpfs, mode 700, clean)"
    }
  }

  var recipient = master_recipient_pubkey(AGENIX_MODULE)
  if (recipient === '') {
    report_error 'Master recipient' $"cannot read an age pubkey from ${AGENIX_MODULE}"
    setvar errors += 1
  } else {
    var home_agenix = read_file(HOME_AGENIX_MODULE)
    if (home_agenix === null) {
      report_error 'Master recipient' $"cannot read ${HOME_AGENIX_MODULE}"
      setvar errors += 1
    } elif (not home_agenix.contains('lib/agenix.nix')) {
      report_error 'Master recipient' $"${HOME_AGENIX_MODULE} does not import masterIdentity from ${AGENIX_MODULE}"
      setvar errors += 1
    } else {
      report_ok 'Master recipient' $"${recipient} (nixos & home-manager match)"
    }
  }

  log_section 'Workstation SSH Key'
  var home = get(ENV, 'HOME', '')
  if (home === '') {
    report_warn 'Private key' 'HOME is unset; cannot check the SSH key'
    setvar warnings += 1
  } else {
    var ssh_key = home ++ '/.ssh/id_ed25519'
    var derived = ''
    try { test -L $ssh_key }
    if (_error.code === 0) {
      try { test -e $ssh_key }
      if failed {
        report_error 'Private key' $"${ssh_key} is a broken symlink; run just secret-ssh-restore"
      } else {
        report_error 'Private key' $"${ssh_key} is a symlink; run just secret-ssh-restore to install a regular key"
      }
      setvar errors += 1
    } else {
      try { test -f $ssh_key }
      if (_error.code !== 0) {
        report_warn 'Private key' $"${ssh_key} is absent; run just secret-ssh-restore to restore it from Bitwarden"
        setvar warnings += 1
      } else {
        var ssh_mode = ''
        try { setvar ssh_mode = $(stat -L -c %a $ssh_key) }
        if (ssh_mode === '') {
          report_warn 'Private key' $"cannot stat ${ssh_key}"
          setvar warnings += 1
        } elif (ssh_mode !== '600' and ssh_mode !== '400') {
          report_error 'Private key' $"${ssh_key} mode is ${ssh_mode}, expected 600 or 400"
          setvar errors += 1
        } else {
          try { setvar derived = $(ssh-keygen -y -f $ssh_key 2>/dev/null) }
          setvar derived = derived.trim()
          if (derived === '') {
            report_error 'Private key' $"${ssh_key} (mode ${ssh_mode}) has no derivable public key"
            setvar errors += 1
          } else {
            report_ok 'Private key' $"${ssh_key} (mode ${ssh_mode})"
          }
        }
      }
    }

    if (derived !== '') {
      var pub_path = ssh_key ++ '.pub'
      var pub_detail = $"matches ${pub_path}"
      var pub_ok = true
      try { test -f $pub_path }
      if (_error.code !== 0) {
        report_warn 'Public key' $"${pub_path} is absent; run just secret-ssh-restore"
        setvar warnings += 1
        setvar pub_ok = false
      } else {
        var pub_text = read_file(pub_path)
        if (pub_text === null) {
          report_warn 'Public key' $"cannot read ${pub_path}"
          setvar warnings += 1
          setvar pub_ok = false
        } elif (ssh_pubkey_core(pub_text) !== ssh_pubkey_core(derived)) {
          report_error 'Public key' $"${pub_path} does not match ${ssh_key}; run just secret-ssh-restore"
          setvar errors += 1
          setvar pub_ok = false
        }
      }
      var current = agenix_bw_current_hostname()
      if (current === '') {
        report_warn 'Public key' 'cannot determine the hostname; skipping the home-manager age.rekey.hostPubkey check'
        setvar warnings += 1
      } else {
        var expected = host_home_ssh_pubkey(current)
        if (expected === '') {
          setvar pub_detail = $"matches ${pub_path} (hosts/${current}/default.nix defines no home-manager hostPubkey)"
        } elif (ssh_pubkey_core(expected) !== ssh_pubkey_core(derived)) {
          report_error 'Public key' $"${ssh_key} does not match the home-manager age.rekey.hostPubkey in hosts/${current}/default.nix"
          setvar errors += 1
          setvar pub_ok = false
        } else {
          setvar pub_detail = $"matches ${pub_path} and hosts/${current}/default.nix"
        }
      }
      if (pub_ok) {
        report_ok 'Public key' $pub_detail
      }
    }
  }

  log_section 'Repository Secrets'
  var master_files = ''
  try { setvar master_files = $(find $MASTER_DIR -type f -name '*.age' 2>/dev/null) }
  var master_count = count_nonempty_lines(master_files)
  if (master_count === 0) {
    report_warn 'Master secrets' $"no .age files under ${MASTER_DIR}"
    setvar warnings += 1
  } else {
    report_ok 'Master secrets' $"${master_count} file(s) under ${MASTER_DIR}"
  }

  var age_files = ''
  try { setvar age_files = $(find secrets/master secrets/rekeyed -type f -name '*.age' 2>/dev/null) }
  var age_count = 0
  var bad_age = 0
  for file in (age_files.split(u'\n')) {
    if (file === '') {
      continue
    }
    setvar age_count += 1
    var first_line = ''
    try { setvar first_line = $(head -n 1 $file) }
    if failed {
      report_error 'Age ciphertexts' $"cannot read ${file}"
      setvar bad_age += 1
    } elif (first_line !== 'age-encryption.org/v1') {
      report_error 'Age ciphertexts' $"${file} is not an age ciphertext"
      setvar bad_age += 1
    }
  }
  if (bad_age > 0) {
    setvar errors += bad_age
  } else {
    report_ok 'Age ciphertexts' $"${age_count} file(s) under secrets/master, secrets/rekeyed"
  }

  try { git check-ignore -q $STAGING_DIR/probe }
  var staging_ignored = (_error.code === 0)
  var staged_out = ''
  try { setvar staged_out = $(find $STAGING_DIR -type f 2>/dev/null) }
  var staged_count = count_nonempty_lines(staged_out)
  var staging_ok = true
  if (not staging_ignored) {
    report_warn 'Staging directory' $"${STAGING_DIR}/ is not ignored by git"
    setvar warnings += 1
    setvar staging_ok = false
  }
  if (staged_count > 0) {
    report_warn 'Staging directory' $"${STAGING_DIR}/ has ${staged_count} pending plaintext file(s); run just secret-apply-staging"
    setvar warnings += 1
    setvar staging_ok = false
  }
  if (staging_ok) {
    report_ok 'Staging directory' $"${STAGING_DIR}/ (git-ignored, no pending files)"
  }

  log_section 'Runtime & Bitwarden'
  if (get(ENV, 'AGENIX_SWAP_GUARD', '') === '1') {
    report_ok 'Swap guard' 'active (MemorySwapMax=0)'
  } else {
    report_warn 'Swap guard' 'inactive; the master identity may be swappable'
    setvar warnings += 1
  }

  if (bw_verdict === 'ok') {
    report_ok 'Bitwarden vault' $bw_detail
  } elif (bw_verdict === 'warn') {
    report_warn 'Bitwarden vault' $bw_detail
    setvar warnings += 1
  } else {
    report_error 'Bitwarden vault' $bw_detail
    setvar errors += 1
  }

  echo ''
  if (errors > 0) {
    log_error $"Doctor failed (${errors} error(s), ${warnings} warning(s))" (stream='stdout')
    exit 1
  }
  if (warnings > 0) {
    log_warn $"Doctor passed with ${warnings} warning(s)" (stream='stdout')
  } else {
    log_ok 'Doctor passed (0 errors, 0 warnings)'
  }
}

if (len(ARGV) === 0) {
  usage
  exit 2
}

var command = ARGV[0]
var command_args = ARGV[1:]

cd $_this_dir/../.. {
  case (command) {
    ('rekey') { rekey (command_args) }
    ('edit') { edit (command_args) }
    ('apply-staging') { apply_staging (command_args) }
    ('ssh-restore') { ssh_restore (command_args) }
    ('ssh-backup') { ssh_backup (command_args) }
    ('doctor') { doctor (command_args) }
    ('-h') { usage }
    ('--help') { usage }
    (else) {
      log_error $"unknown command: ${command}"
      usage
      exit 2
    }
  }
}
