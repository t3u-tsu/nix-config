#!/usr/bin/env ysh
#
# Backward-compatibility router for the single-purpose scripts in
# scripts/secrets/. It forwards old `secret.ysh <command>` invocations to the
# matching script; prefer `just secret <command>` or the script directly.
#
# Usage:
#   ysh scripts/secrets/secret.ysh <command> [args...]
#
# The Bitwarden master identity is reused from lib/bitwarden.ysh. A missing
# BW_SESSION falls back to the token held by lib/agent.pl, and a locked vault
# triggers `bw unlock` only when stdin is a TTY; non-interactive runs must pass
# BW_SESSION or unlock once beforehand.

source $_this_dir/lib/bitwarden.ysh

agenix_bw_swap_guard $0 @[ARGV]

proc usage() {
  echo 'usage: ysh scripts/secrets/secret.ysh <command> [args...]'
  echo ''
  echo 'commands:'
  echo '  rekey [agenix args...]                           Run agenix rekey with the master identity'
  echo '  edit <file>                                      Edit a master secret file'
  echo '  unlock [--raw | --env]                           Log in / unlock Bitwarden and print the session'
  echo '  lock                                             Lock Bitwarden and purge the in-memory session agent'
  echo '  apply-staging [--dry-run] [--no-rekey]           Encrypt .secrets-staging files and rekey'
  echo '  set-host-password <hostname...|--all>            Set user password with yescrypt and encrypt to master secrets'
  echo '  ssh-restore [hostname] [--file <path>] [--force] Restore an SSH private key from Bitwarden'
  echo '  ssh-backup [hostname] [--file <path>] [--force]  Back up an SSH private key to Bitwarden'
  echo '  doctor                                           Check tools, master identity, Bitwarden, and staging'
}

const COMMANDS = {
  'rekey': 'rekey.ysh',
  'edit': 'edit.ysh',
  'unlock': 'unlock.ysh',
  'lock': 'lock.ysh',
  'apply-staging': 'apply-staging.ysh',
  'set-host-password': 'set-host-password.ysh',
  'ssh-restore': 'ssh-restore.ysh',
  'ssh-backup': 'ssh-backup.ysh',
  'doctor': 'doctor.ysh',
}

if (len(ARGV) === 0) {
  usage
  exit 2
}

var command = ARGV[0]
if (command === '-h' or command === '--help') {
  usage
  exit 0
}
var script = get(COMMANDS, command, '')
if (script === '') {
  log_error $"unknown command: ${command}"
  usage
  exit 2
}

var script_path = _this_dir ++ '/' ++ script
exec $script_path @[ARGV[1:]]
