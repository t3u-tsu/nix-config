#!/usr/bin/env ysh
#
# Unified CLI for the agenix-rekey secret workflows.
#
# Usage:
#   ysh scripts/secrets/secret.ysh rekey [agenix args...]
#   ysh scripts/secrets/secret.ysh edit <file>
#   ysh scripts/secrets/secret.ysh apply-staging [--dry-run] [--no-rekey]
#   ysh scripts/secrets/secret.ysh ssh-restore [hostname] [--force]
#   ysh scripts/secrets/secret.ysh ssh-backup [hostname] [--file <path>]
#   ysh scripts/secrets/secret.ysh doctor
#
# The Bitwarden master identity is reused from agenix-bw-lib.ysh. A missing
# BW_SESSION or a locked vault triggers `bw unlock` only when stdin is a TTY;
# non-interactive runs must pass BW_SESSION. Missing tools are reported with
# the command name before any secret work starts.

source $_this_dir/agenix-bw-lib.ysh

agenix_bw_swap_guard $0 @[ARGV]

const STAGING_DIR = '.secrets-staging'
const MASTER_DIR = 'secrets/master'
const AGENIX_MODULE = 'lib/agenix.nix'
const HOME_AGENIX_MODULE = 'home/agenix.nix'

proc usage() {
  echo 'usage: ysh scripts/secrets/secret.ysh <command> [args...]'
  echo ''
  echo 'commands:'
  echo '  rekey [agenix args...]                  Run agenix rekey with the master identity'
  echo '  edit <file>                             Edit a master secret file'
  echo '  apply-staging [--dry-run] [--no-rekey]  Encrypt .secrets-staging files and rekey'
  echo '  ssh-restore [hostname] [--force]        Restore ~/.ssh/id_ed25519 from Bitwarden'
  echo '  ssh-backup [hostname] [--file <path>]   Back up an SSH private key to Bitwarden'
  echo '  doctor                                  Check tools, master identity, Bitwarden, and staging'
}

proc die(msg) {
  echo $"ERROR: ${msg}" >&2
  exit 1
}

func is_safe_relative(path) {
  if (path === '' or path.startsWith('/')) {
    return (false)
  }
  for part in (path.split(u'/')) {
    if (part === '..') {
      return (false)
    }
  }
  return (true)
}

func parent_dir(path) {
  var parts = path.split(u'/')
  if (len(parts) < 2) {
    return ('.')
  }
  var joined = join(parts[0:len(parts) - 1], '/')
  if (joined === '') {
    if (path.startsWith('/')) {
      return ('/')
    }
    return ('.')
  }
  return (joined)
}

func file_exists(path) {
  try { test -f $path }
  return (_error.code === 0)
}

func read_file(path) {
  var content = ''
  try { read --all (&content) < $path }
  if failed {
    return (null)
  }
  return (content)
}

func master_recipient_pubkey(path) {
  var content = read_file(path)
  if (content === null) {
    return ('')
  }
  for line in (content.split(u'\n')) {
    if (line.trim().startsWith('#')) {
      continue
    }
    if (line.contains('pubkey')) {
      var parts = line.split(u'"')
      if (len(parts) >= 2 and parts[1].startsWith('age1')) {
        return (parts[1])
      }
    }
  }
  return ('')
}

func ssh_pubkey_core(line) {
  var fields = line.trim().split(u' ')
  if (len(fields) < 2) {
    return (line.trim())
  }
  return (fields[0] ++ ' ' ++ fields[1])
}

# Only the home-manager block rekeys home secrets, so the top-level
# hostPubkey (the machine host key) must not be used for comparison.
func host_home_ssh_pubkey(hostname) {
  if (hostname === '') {
    return ('')
  }
  var path = 'hosts/' ++ hostname ++ '/default.nix'
  try { test -f $path }
  if (_error.code !== 0) {
    return ('')
  }
  var content = read_file(path)
  if (content === null) {
    return ('')
  }
  var in_home_block = false
  for line in (content.split(u'\n')) {
    var stripped = line.trim()
    if (stripped.startsWith('#')) {
      continue
    }
    if (stripped.contains('home-manager.users')) {
      setvar in_home_block = true
      continue
    }
    if (not in_home_block or not stripped.contains('age.rekey.hostPubkey')) {
      continue
    }
    for part in (stripped.split(u'"')) {
      if (part.startsWith('ssh-ed25519 ')) {
        return (part)
      }
    }
  }
  return ('')
}

func valid_hostname(name) {
  return (name ~ '^[A-Za-z0-9][A-Za-z0-9._-]*$')
}

# Bitwarden reads the base64 payload from stdin; passing it as an argument
# would expose the private key in ps output.
func ssh_submit_item(payload, item_id) {
  var encoded = ''
  shopt --unset verbose_errexit {
    try { setvar encoded = $(json write (payload) | base64 -w0) }
  }
  if (encoded === '') {
    return (false)
  }
  var ok = false
  shopt --unset verbose_errexit {
    try {
      if (item_id === '') {
        write --end '' -- $encoded | bw create item >/dev/null
      } else {
        write --end '' -- $encoded | bw edit item $item_id >/dev/null
      }
    }
    if (_error.code === 0) {
      setvar ok = true
    }
  }
  return (ok)
}

func staging_target(file) {
  var rel = file
  if (rel.startsWith(STAGING_DIR ++ '/')) {
    setvar rel = rel[len(STAGING_DIR ++ '/'):]
  }
  if (rel.startsWith(MASTER_DIR ++ '/')) {
    setvar rel = rel[len(MASTER_DIR ++ '/'):]
  }
  if (not is_safe_relative(rel)) {
    return (null)
  }
  if (rel.endsWith('.age')) {
    return (MASTER_DIR ++ '/' ++ rel)
  }
  return (MASTER_DIR ++ '/' ++ rel ++ '.age')
}

proc shred_staged(file) {
  try { shred -u -- $file }
  if failed {
    try { rm -f -- $file }
  }
  if failed {
    echo $"WARN: could not remove staged file ${file}" >&2
  }
}

proc agenix_with_identity(; args; tmpdir='') {
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  var pubkey = agenix_bw_primary_identity()
  if (pubkey === '') {
    die 'cannot derive the master recipient from the Bitwarden key'
  }
  var agenix_env = [
    'AGENIX_MASTER_KEY_FILE=' ++ agenix_bw_key_path,
    'AGENIX_REKEY_PRIMARY_IDENTITY=' ++ pubkey,
  ]
  if (tmpdir !== '') {
    call agenix_env->append('TMPDIR=' ++ tmpdir)
  }
  env @[agenix_env] $agenix_cmd @[args]
}

proc run_with_agenix(; args; key_dir_tmpdir=false) {
  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  agenix_bw_require 'bw'
  agenix_bw_require 'age-keygen'
  agenix_bw_require $agenix_cmd
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity
  if (key_dir_tmpdir) {
    agenix_with_identity (args; tmpdir=agenix_bw_key_dir)
  } else {
    agenix_with_identity (args)
  }
}

proc rekey(; args) {
  shopt --unset verbose_errexit
  try { git add -N -- secrets/ 2>/dev/null }
  try { git add -N -- nixos/networking/nebula/ 2>/dev/null }
  try { git add -N -- hosts/*/nebula.crt 2>/dev/null }
  run_with_agenix (['rekey'] ++ args)
  try { git add -u -- secrets/rekeyed/ 2>/dev/null }
  try { git add -N -- secrets/ 2>/dev/null }
}

proc edit(; args) {
  if (len(args) !== 1) {
    usage
    exit 2
  }
  var file = args[0]
  if (not file_exists(file)) {
    die $"secret file not found: ${file}"
  }
  shopt --unset verbose_errexit
  # Keep cleartext edit scratch files inside the noswap tmpfs.
  run_with_agenix (['edit', file]; key_dir_tmpdir=true)
}

proc apply_staging(; args) {
  var dry_run = false
  var no_rekey = false
  for arg in (args) {
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--dry-run') { setvar dry_run = true }
      ('--no-rekey') { setvar no_rekey = true }
      (else) {
        echo $"ERROR: unknown argument: ${arg}" >&2
        exit 2
      }
    }
  }

  try { test -d $STAGING_DIR }
  if failed {
    echo $"No ${STAGING_DIR} directory; nothing to apply."
    return
  }

  var find_out = ''
  try { setvar find_out = $(find $STAGING_DIR -type f -not -name '*~' -not -name '*.swp' -not -name '*.swo') }
  if failed {
    die $"cannot scan ${STAGING_DIR}"
  }

  var plan = []
  var seen = {}
  for file in (find_out.split(u'\n')) {
    if (file === '') {
      continue
    }
    var target = staging_target(file)
    if (target === null) {
      die $"unsafe staging path: ${file}"
    }
    if (target in seen) {
      var prior = seen[target]
      die $"both ${prior} and ${file} map to ${target}"
    }
    setvar seen[target] = file
    call plan->append({ source: file, target: target })
  }
  if (len(plan) === 0) {
    echo $"No staged secrets in ${STAGING_DIR}."
    return
  }

  if (dry_run) {
    for item in (plan) {
      var plan_target = item.target
      var plan_source = item.source
      echo $"PLAN: ${plan_target} <- ${plan_source}"
    }
    var plan_count = len(plan)
    echo $"Dry run: ${plan_count} staged file(s)."
    return
  }

  shopt --unset verbose_errexit
  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = agenix_bw_primary_identity()
  if (recipient === '') {
    die 'cannot derive the master recipient from the Bitwarden key'
  }

  var written = 0
  var failed_count = 0
  for item in (plan) {
    var item_source = item.source
    var item_target = item.target
    mkdir -p $[parent_dir(item_target)]
    try { agenix_bw_encrypt_file (item_source, item_target, recipient) }
    if failed {
      echo $"ERROR: failed to encrypt ${item_target}" >&2
      setvar failed_count += 1
      continue
    }
    echo $"OK: encrypted ${item_target}"
    setvar written += 1
    shred_staged $item_source
  }

  try { find $STAGING_DIR -mindepth 1 -type d -empty -delete }
  if failed {
    echo $"WARN: could not prune empty directories under ${STAGING_DIR}" >&2
  }

  var staged_left = ''
  try { setvar staged_left = $(find $STAGING_DIR -type f 2>/dev/null) }
  if failed {
    setvar staged_left = ''
  }
  if (staged_left !== '') {
    echo $"WARN: staged plaintext remains in ${STAGING_DIR}" >&2
    setvar failed_count += 1
  } else {
    try { rmdir $STAGING_DIR 2>/dev/null }
  }

  if (written > 0 and not no_rekey) {
    var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
    agenix_bw_require $agenix_cmd
    try { git add -N -- secrets/ >/dev/null 2>&1 }
    try { agenix_with_identity (['rekey']) }
    if failed {
      echo 'ERROR: agenix rekey failed; rekeyed secrets were not staged' >&2
      exit 1
    }
    try { git add -A -- secrets/rekeyed/ }
    if failed {
      echo 'WARN: could not stage secrets/rekeyed/' >&2
    }
  }
  if (failed_count > 0) {
    exit 1
  }
}

proc ssh_restore(; args) {
  var force = false
  var hostname = ''
  for arg in (args) {
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--force') { setvar force = true }
      (else) {
        if (arg.startsWith('-')) {
          echo $"ERROR: unknown option: ${arg}" >&2
          exit 2
        }
        if (hostname !== '') {
          echo 'ERROR: ssh-restore accepts at most one hostname' >&2
          exit 2
        }
        setvar hostname = arg
      }
    }
  }
  if (hostname === '') {
    setvar hostname = agenix_bw_current_hostname()
  }
  if (hostname === '') {
    die 'cannot determine the hostname; pass one explicitly'
  }
  if (not valid_hostname(hostname)) {
    die $"invalid hostname: ${hostname}"
  }
  var home = get(ENV, 'HOME', '')
  if (home === '') {
    die 'HOME is unset'
  }

  shopt --unset verbose_errexit
  agenix_bw_require 'bw'
  agenix_bw_require 'ssh-keygen'
  agenix_bw_session_init
  var item = agenix_bw_ssh_find_item(hostname)
  if (item === null) {
    die $"no Bitwarden SSH key item for ${hostname} under ${agenix_bw_ssh_folder_name}; run just secret-ssh-backup on ${hostname}"
  }
  var private_text = agenix_bw_ssh_private_key(item)
  if (private_text === '') {
    die $"Bitwarden item for ${hostname} does not contain an SSH private key"
  }
  setvar private_text = agenix_bw_ssh_normalize_private(private_text)
  var derived = agenix_bw_ssh_derive_public_key(private_text)
  if (derived === '') {
    die $"the Bitwarden item for ${hostname} is not an unencrypted SSH private key"
  }

  var ssh_dir = home ++ '/.ssh'
  var key_path = ssh_dir ++ '/id_ed25519'
  var pub_path = key_path ++ '.pub'

  try { test -L $ssh_dir }
  if (_error.code === 0) {
    die $"refusing symlinked SSH directory: ${ssh_dir}"
  }
  try { mkdir -p $ssh_dir }
  if failed {
    die $"cannot create ${ssh_dir}"
  }
  chmod 700 $ssh_dir

  # Legacy sops-nix installs symlinked the key into /run/secrets; replace the
  # link instead of writing through it.
  try { test -L $key_path }
  if (_error.code === 0) {
    echo $"Removing legacy symlink ${key_path}" >&2
    try { rm -f -- $key_path }
    if failed {
      die $"cannot remove ${key_path}"
    }
  }
  for target in ([key_path, pub_path]) {
    try { test -d $target }
    if (_error.code === 0) {
      die $"${target} is a directory; remove it before restoring"
    }
  }
  var overwriting = false
  try { test -f $key_path }
  if (_error.code === 0) {
    var current = read_file(key_path)
    if (current === null) {
      if (not force) {
        die $"cannot read the existing ${key_path}; pass --force to replace it"
      }
      setvar overwriting = true
    } elif (current.trim() !== private_text.trim()) {
      if (not force) {
        die $"${key_path} already exists with different content; pass --force to replace it"
      }
      setvar overwriting = true
    }
  }
  if (overwriting) {
    echo $"WARN: overwriting ${key_path}" >&2
  }

  var tmp = ''
  try { setvar tmp = $(mktemp -- $"${ssh_dir}/.id_ed25519.XXXXXX") }
  if (tmp === '') {
    die $"cannot create a temporary key in ${ssh_dir}"
  }
  agenix_bw_add_temp $tmp
  try { write --end '' -- $private_text > $tmp }
  if failed {
    die $"cannot write a temporary private key in ${ssh_dir}"
  }
  chmod 600 $tmp
  try { mv -f -- $tmp $key_path }
  if failed {
    die $"cannot install ${key_path}"
  }
  chmod 600 $key_path

  var stored_public = agenix_bw_ssh_item_public_key(item)
  var public_text = derived
  if (stored_public !== '') {
    if (ssh_pubkey_core(stored_public) === ssh_pubkey_core(derived)) {
      setvar public_text = stored_public
    } else {
      echo $"WARN: the stored public key for ${hostname} does not match the private key; using the derived key" >&2
    }
  }
  var pub_tmp = ''
  try { setvar pub_tmp = $(mktemp -- $"${ssh_dir}/.id_ed25519.pub.XXXXXX") }
  if (pub_tmp === '') {
    die $"cannot create a temporary public key in ${ssh_dir}"
  }
  agenix_bw_add_temp $pub_tmp
  try { write -- $public_text > $pub_tmp }
  if failed {
    die $"cannot write ${pub_path}"
  }
  chmod 644 $pub_tmp
  try { mv -f -- $pub_tmp $pub_path }
  if failed {
    die $"cannot install ${pub_path}"
  }
  chmod 644 $pub_path
  echo $"OK: restored ${key_path} from ${agenix_bw_ssh_folder_name}/${hostname}"

  var expected = host_home_ssh_pubkey(hostname)
  if (expected === '') {
    echo $"INFO: hosts/${hostname}/default.nix has no home-manager age.rekey.hostPubkey to compare"
  } elif (ssh_pubkey_core(expected) !== ssh_pubkey_core(derived)) {
    echo $"WARN: the restored key does not match the home-manager age.rekey.hostPubkey in hosts/${hostname}/default.nix" >&2
  } else {
    echo 'OK: the restored key matches the home-manager age.rekey.hostPubkey'
  }

  if (agenix_bw_current_hostname() === hostname) {
    var units = []
    for unit in (['agenix.service', 'import-gpg-key.service']) {
      try { systemctl --user cat $unit >/dev/null 2>&1 }
      if (_error.code === 0) {
        call units->append(unit)
      }
    }
    for unit in (units) {
      try { systemctl --user restart $unit }
      if failed {
        echo $"WARN: could not restart ${unit}; restart it manually" >&2
      } else {
        echo $"OK: restarted ${unit}"
      }
    }
  }
}

proc ssh_backup(; args) {
  var hostname = ''
  var key_path = ''
  var i = 0
  while (i < len(args)) {
    var arg = args[i]
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--file') {
        setvar i += 1
        if (i >= len(args)) {
          echo 'ERROR: --file requires a path' >&2
          exit 2
        }
        setvar key_path = args[i]
      }
      (else) {
        if (arg.startsWith('-')) {
          echo $"ERROR: unknown option: ${arg}" >&2
          exit 2
        }
        if (hostname !== '') {
          echo 'ERROR: ssh-backup accepts at most one hostname' >&2
          exit 2
        }
        setvar hostname = arg
      }
    }
    setvar i += 1
  }
  var home = get(ENV, 'HOME', '')
  if (key_path === '') {
    if (home === '') {
      die 'HOME is unset'
    }
    setvar key_path = home ++ '/.ssh/id_ed25519'
  }
  if (hostname === '') {
    setvar hostname = agenix_bw_current_hostname()
  }
  if (hostname === '') {
    die 'cannot determine the hostname; pass one explicitly'
  }
  if (not valid_hostname(hostname)) {
    die $"invalid hostname: ${hostname}"
  }

  shopt --unset verbose_errexit
  try { test -e $key_path }
  if (_error.code !== 0) {
    die $"SSH private key not found or a broken symlink: ${key_path}"
  }
  try { test -f $key_path }
  if (_error.code !== 0) {
    die $"not a regular file: ${key_path}"
  }
  var private_text = read_file(key_path)
  if (private_text === null) {
    die $"cannot read ${key_path}"
  }
  setvar private_text = agenix_bw_ssh_normalize_private(private_text)

  agenix_bw_require 'bw'
  agenix_bw_require 'ssh-keygen'
  agenix_bw_require 'base64'
  agenix_bw_session_init
  var public_text = agenix_bw_ssh_derive_public_key(private_text)
  if (public_text === '') {
    die $"cannot derive a public key from ${key_path}; is it an unencrypted private key?"
  }
  var fingerprint = agenix_bw_ssh_fingerprint(key_path)
  if (fingerprint === '') {
    echo $"WARN: cannot read the SHA256 fingerprint of ${key_path}" >&2
  }

  agenix_bw_ssh_ensure_folder
  var folder = agenix_bw_ssh_folder_id()
  var existing = agenix_bw_ssh_folder_item(hostname)
  var item_id = ''
  if (existing !== null) {
    setvar item_id = get(existing, 'id', '') or ''
  }

  var ssh_payload = null
  if (existing !== null and item_id !== '') {
    setvar ssh_payload = existing
    call ssh_payload->erase('secureNote')
    setvar ssh_payload.type = 5
    setvar ssh_payload.folderId = folder
    setvar ssh_payload.name = hostname
    setvar ssh_payload.notes = null
    setvar ssh_payload.sshKey = {
      privateKey: private_text,
      publicKey: public_text,
      keyFingerprint: fingerprint,
    }
  } else {
    setvar ssh_payload = {
      organizationId: null,
      folderId: folder,
      type: 5,
      name: hostname,
      notes: null,
      favorite: false,
      reprompt: 0,
      sshKey: {
        privateKey: private_text,
        publicKey: public_text,
        keyFingerprint: fingerprint,
      },
    }
  }
  if (ssh_submit_item (ssh_payload, item_id)) {
    echo $"OK: stored ${key_path} in Bitwarden as ${agenix_bw_ssh_folder_name}/${hostname}"
    return
  }
  echo 'WARN: Bitwarden rejected the SSH key item; retrying as a secure note' >&2

  var note_payload = null
  if (existing !== null and item_id !== '') {
    setvar note_payload = existing
    call note_payload->erase('sshKey')
    setvar note_payload.type = 2
    setvar note_payload.folderId = folder
    setvar note_payload.name = hostname
    setvar note_payload.notes = private_text
    setvar note_payload.secureNote = { type: 0 }
  } else {
    setvar note_payload = {
      organizationId: null,
      folderId: folder,
      type: 2,
      name: hostname,
      notes: private_text,
      favorite: false,
      reprompt: 0,
      secureNote: { type: 0 },
    }
  }
  if (not ssh_submit_item (note_payload, item_id)) {
    die $"cannot store ${key_path} in Bitwarden folder ${agenix_bw_ssh_folder_name}"
  }
  echo $"OK: stored ${key_path} in Bitwarden as a secure note ${agenix_bw_ssh_folder_name}/${hostname}"
}

proc doctor(; args) {
  if (len(args) > 0) {
    usage
    exit 2
  }

  shopt --unset verbose_errexit
  var errors = 0
  var warnings = 0

  var agenix_cmd = get(ENV, 'AGENIX_CMD', 'agenix')
  for tool in (['bw', 'age', 'age-keygen', agenix_cmd, 'git', 'ssh-keygen']) {
    try { command -v $tool >/dev/null 2>&1 }
    if failed {
      echo $"ERROR: ${tool} not found on PATH (run within nix develop)"
      setvar errors += 1
    } else {
      echo $"OK: ${tool}"
    }
  }
  try { command -v shred >/dev/null 2>&1 }
  if failed {
    echo 'WARN: shred not found; staged plaintext falls back to rm -f'
    setvar warnings += 1
  } else {
    echo 'OK: shred'
  }

  var master_dir = get(ENV, 'AGENIX_MASTER_KEY_DIR', '/run/agenix-master')
  try { test -d $master_dir }
  if failed {
    echo $"WARN: master identity directory ${master_dir} is absent; apply nixos/security/agenix.nix"
    setvar warnings += 1
  } else {
    var dir_mode = ''
    try { setvar dir_mode = $(stat -L -c %a $master_dir) }
    if failed {
      echo $"WARN: cannot stat ${master_dir}"
      setvar warnings += 1
    } elif (dir_mode !== '700') {
      echo $"WARN: ${master_dir} mode is ${dir_mode}, expected 700"
      setvar warnings += 1
    } else {
      echo $"OK: ${master_dir} mode 700"
    }

    var mount_entry = agenix_bw_mount_entry(master_dir)
    if (mount_entry === null) {
      echo $"WARN: cannot determine the filesystem for ${master_dir}"
      setvar warnings += 1
    } elif (mount_entry.fstype !== 'tmpfs') {
      var mount_fs = mount_entry.fstype
      echo $"ERROR: ${master_dir} is on ${mount_fs}, not tmpfs"
      setvar errors += 1
    } elif (not agenix_bw_mount_has_option(mount_entry, 'noswap')) {
      echo $"WARN: ${master_dir} is not mounted with noswap"
      setvar warnings += 1
    } elif (mount_entry.point !== master_dir) {
      echo $"WARN: ${master_dir} is not a dedicated mount point"
      setvar warnings += 1
    } else {
      echo 'OK: master identity directory is a dedicated noswap tmpfs'
    }

    var key_leftovers = ''
    try { setvar key_leftovers = $(find $master_dir -maxdepth 1 -type f -name 'master-key*' 2>/dev/null) }
    if failed {
      setvar key_leftovers = ''
    }
    var stale_count = 0
    for file in (key_leftovers.split(u'\n')) {
      if (file !== '') {
        echo $"WARN: stale master identity file ${file}"
        setvar stale_count += 1
      }
    }
    if (stale_count === 0) {
      echo 'OK: no stale master identity'
    } else {
      setvar warnings += stale_count
    }
  }

  var home = get(ENV, 'HOME', '')
  if (home === '') {
    echo 'WARN: HOME is unset; cannot check the home-manager SSH key'
    setvar warnings += 1
  } else {
    var ssh_key = home ++ '/.ssh/id_ed25519'
    try { test -L $ssh_key }
    if (_error.code === 0) {
      try { test -e $ssh_key }
      if failed {
        echo $"ERROR: ${ssh_key} is a broken symlink; run just secret-ssh-restore"
      } else {
        echo $"ERROR: ${ssh_key} is a symlink; run just secret-ssh-restore to install a regular key"
      }
      setvar errors += 1
    } else {
      try { test -f $ssh_key }
      if (_error.code !== 0) {
        echo $"WARN: ${ssh_key} is absent; run just secret-ssh-restore to restore it from Bitwarden"
        setvar warnings += 1
      } else {
        var ssh_mode = ''
        try { setvar ssh_mode = $(stat -L -c %a $ssh_key) }
        if failed {
          echo $"WARN: cannot stat ${ssh_key}"
          setvar warnings += 1
        } elif (ssh_mode !== '600' and ssh_mode !== '400') {
          echo $"ERROR: ${ssh_key} mode is ${ssh_mode}, expected 600 or 400"
          setvar errors += 1
        } else {
          echo $"OK: ${ssh_key} mode ${ssh_mode}"
        }

        var derived = ''
        try { setvar derived = $(ssh-keygen -y -f $ssh_key 2>/dev/null) }
        if (_error.code !== 0 or derived.trim() === '') {
          echo $"ERROR: cannot derive a public key from ${ssh_key}"
          setvar errors += 1
        } else {
          setvar derived = derived.trim()
          var pub_path = ssh_key ++ '.pub'
          try { test -f $pub_path }
          if (_error.code !== 0) {
            echo $"WARN: ${pub_path} is absent; run just secret-ssh-restore"
            setvar warnings += 1
          } else {
            var pub_text = read_file(pub_path)
            if (pub_text === null) {
              echo $"WARN: cannot read ${pub_path}"
              setvar warnings += 1
            } elif (ssh_pubkey_core(pub_text) !== ssh_pubkey_core(derived)) {
              echo $"ERROR: ${pub_path} does not match ${ssh_key}; run just secret-ssh-restore"
              setvar errors += 1
            } else {
              echo $"OK: ${pub_path} matches ${ssh_key}"
            }
          }

          var current = agenix_bw_current_hostname()
          if (current === '') {
            echo 'WARN: cannot determine the hostname; skipping the home-manager age.rekey.hostPubkey check'
            setvar warnings += 1
          } else {
            var expected = host_home_ssh_pubkey(current)
            if (expected === '') {
              echo $"OK: hosts/${current}/default.nix defines no home-manager age.rekey.hostPubkey"
            } elif (ssh_pubkey_core(expected) !== ssh_pubkey_core(derived)) {
              echo $"ERROR: ${ssh_key} does not match the home-manager age.rekey.hostPubkey in hosts/${current}/default.nix"
              setvar errors += 1
            } else {
              echo 'OK: the SSH key matches the home-manager age.rekey.hostPubkey'
            }
          }
        }
      }
    }
  }

  var recipient = master_recipient_pubkey(AGENIX_MODULE)
  if (recipient === '') {
    echo $"ERROR: cannot read an age pubkey from ${AGENIX_MODULE}"
    setvar errors += 1
  } else {
    echo $"OK: master recipient ${recipient}"

    var home_agenix = read_file(HOME_AGENIX_MODULE)
    if (home_agenix === null) {
      echo $"ERROR: cannot read ${HOME_AGENIX_MODULE}"
      setvar errors += 1
    } elif (not home_agenix.contains('lib/agenix.nix')) {
      echo $"ERROR: ${HOME_AGENIX_MODULE} does not import masterIdentity from ${AGENIX_MODULE}"
      setvar errors += 1
    } else {
      echo 'OK: nixos and home master identities match'
    }
  }

  var master_files = ''
  try { setvar master_files = $(find $MASTER_DIR -type f -name '*.age' 2>/dev/null) }
  if failed {
    setvar master_files = ''
  }
  var master_count = 0
  for file in (master_files.split(u'\n')) {
    if (file !== '') {
      setvar master_count += 1
    }
  }
  if (master_count === 0) {
    echo $"WARN: no .age files under ${MASTER_DIR}"
    setvar warnings += 1
  } else {
    echo $"OK: ${master_count} master secret file(s)"
  }

  var age_files = ''
  try { setvar age_files = $(find secrets/master secrets/rekeyed -type f -name '*.age' 2>/dev/null) }
  if failed {
    setvar age_files = ''
  }
  var age_count = 0
  var bad_age = 0
  for file in (age_files.split(u'\n')) {
    if (file === '') {
      continue
    }
    setvar age_count += 1
    var first_line = ''
    try { setvar first_line = $(head -n 1 $file) }
    if failed {
      echo $"ERROR: cannot read ${file}"
      setvar bad_age += 1
    } elif (first_line !== 'age-encryption.org/v1') {
      echo $"ERROR: ${file} is not an age ciphertext"
      setvar bad_age += 1
    }
  }
  if (bad_age > 0) {
    setvar errors += bad_age
  } else {
    echo $"OK: ${age_count} age ciphertext file(s)"
  }

  try { git check-ignore -q $STAGING_DIR/probe }
  if failed {
    echo $"WARN: ${STAGING_DIR}/ is not ignored by git"
    setvar warnings += 1
  } else {
    echo $"OK: ${STAGING_DIR}/ is ignored by git"
  }

  var staged_count = 0
  var staged_out = ''
  try { setvar staged_out = $(find $STAGING_DIR -type f 2>/dev/null) }
  if failed {
    setvar staged_out = ''
  }
  for file in (staged_out.split(u'\n')) {
    if (file !== '') {
      setvar staged_count += 1
    }
  }
  if (staged_count > 0) {
    echo $"WARN: ${staged_count} staged plaintext file(s) await just secret-apply-staging"
    setvar warnings += 1
  } else {
    echo 'OK: no staged plaintext files'
  }

  var bw_status = ''
  try { setvar bw_status = $(env -u BW_SESSION bw status --raw) }
  if failed {
    echo 'WARN: cannot read Bitwarden status'
    setvar warnings += 1
  } elif (bw_status === '') {
    echo 'WARN: Bitwarden status was empty'
    setvar warnings += 1
  } else {
    var status_obj = null
    try { json read (&status_obj) <<< $bw_status }
    if failed {
      echo 'WARN: Bitwarden status was not valid JSON'
      setvar warnings += 1
    } elif (type (status_obj) !== 'Dict') {
      echo 'WARN: Bitwarden status was not valid JSON'
      setvar warnings += 1
    } else {
      var state = get(status_obj, 'status', 'unknown')
      if (state === 'unauthenticated') {
        echo 'ERROR: Bitwarden is not logged in; run bw login'
        setvar errors += 1
      } elif (state === 'locked') {
        echo 'WARN: Bitwarden vault is locked; interactive commands prompt for the master password'
        setvar warnings += 1
      } else {
        echo $"OK: Bitwarden vault is ${state}"
      }
    }
  }

  if (get(ENV, 'AGENIX_SWAP_GUARD', '') === '1') {
    echo 'OK: running under the no-swap guard scope'
  } else {
    echo 'WARN: not running under the no-swap guard scope; the master identity may be swappable'
    setvar warnings += 1
  }

  if (get(ENV, 'BW_SESSION', '') === '') {
    echo 'INFO: BW_SESSION is unset; interactive commands unlock via a TTY'
  } else {
    echo 'OK: BW_SESSION is set'
  }

  echo $"Doctor: ${errors} error(s), ${warnings} warning(s)."
  if (errors > 0) {
    exit 1
  }
}

if (len(ARGV) === 0) {
  usage
  exit 2
}

var command = ARGV[0]
var command_args = ARGV[1:]

cd $_this_dir/../.. {
  case (command) {
    ('rekey') { rekey (command_args) }
    ('edit') { edit (command_args) }
    ('apply-staging') { apply_staging (command_args) }
    ('ssh-restore') { ssh_restore (command_args) }
    ('ssh-backup') { ssh_backup (command_args) }
    ('doctor') { doctor (command_args) }
    ('-h') { usage }
    ('--help') { usage }
    (else) {
      echo $"ERROR: unknown command: ${command}" >&2
      usage
      exit 2
    }
  }
}
