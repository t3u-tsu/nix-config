#!/usr/bin/env ysh
#
# Re-encrypt every master secret for all hosts with the Bitwarden master identity.
#
# Usage:
#   ysh scripts/secrets/rekey.ysh [agenix args...]
#

source $_this_dir/lib/bitwarden.ysh

agenix_bw_swap_guard $0 @[ARGV]

shopt --unset verbose_errexit
cd $_this_dir/../.. {
  try { git add -N -- secrets/ 2>/dev/null }
  try { git add -N -- nixos/networking/nebula/ 2>/dev/null }
  try { git add -N -- hosts/*/nebula.crt 2>/dev/null }
  agenix_bw_run_with_agenix (['rekey'] ++ ARGV)
  try { git add -u -- secrets/rekeyed/ 2>/dev/null }
  try { git add -N -- secrets/ 2>/dev/null }
}
