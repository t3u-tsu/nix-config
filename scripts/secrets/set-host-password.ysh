#!/usr/bin/env ysh
#
# Usage: ysh scripts/set-host-password.ysh <hostname>
#
# Hashes the t3u and root passwords with SHA-512 and encrypts them to
# secrets/master/hosts/<hostname>/user_password_hash.age and
# root_password_hash.age with the Bitwarden master identity. Run
# `just secret-rekey` afterwards so each host gets its rekeyed copy.

source $_this_dir/agenix-bw-lib.ysh

agenix_bw_swap_guard $0 @[ARGV]

func valid_hostname(name) {
  return (name ~ '^[A-Za-z0-9][A-Za-z0-9._-]*$')
}

proc usage() {
  echo 'usage: ysh scripts/set-host-password.ysh <hostname>' >&2
}

if (len(ARGV) !== 1) {
  usage
  exit 2
}

var host = ARGV[0]
if (not valid_hostname(host)) {
  echo $"ERROR: invalid hostname: ${host}" >&2
  exit 2
}

shopt --unset verbose_errexit
agenix_bw_require 'mkpasswd'

var t3u_password = ''
try { read -rsp 'password for t3u: ' t3u_password }
if failed {
  echo 'ERROR: password input aborted.' >&2
  exit 1
}
echo
var root_password = ''
try { read -rsp 'password for root: ' root_password }
if failed {
  echo 'ERROR: password input aborted.' >&2
  exit 1
}
echo
if (t3u_password === '' or root_password === '') {
  echo 'ERROR: empty password' >&2
  exit 1
}

# mkpasswd hashes a password passed as an argument, which would expose it in
# /proc/<pid>/cmdline; -s reads it from stdin instead.
var t3u_hash = $(mkpasswd -m sha-512 -s <<< $t3u_password)
var root_hash = $(mkpasswd -m sha-512 -s <<< $root_password)
unset t3u_password root_password
if (not (t3u_hash.startsWith('$6$') and root_hash.startsWith('$6$'))) {
  echo 'ERROR: mkpasswd returned no sha-512 hash' >&2
  exit 1
}

cd $_this_dir/../.. {
  var host_dir = $"secrets/master/hosts/${host}"
  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = agenix_bw_primary_identity()
  if (recipient === '') {
    echo 'ERROR: cannot derive the master recipient from the Bitwarden key' >&2
    exit 1
  }

  var user_target = $"${host_dir}/user_password_hash.age"
  var root_target = $"${host_dir}/root_password_hash.age"
  mkdir -p $host_dir

  try { agenix_bw_encrypt_text (t3u_hash, user_target, recipient) }
  if failed {
    echo $"ERROR: cannot encrypt ${user_target}" >&2
    exit 1
  }
  try { agenix_bw_encrypt_text (root_hash, root_target, recipient) }
  if failed {
    echo $"ERROR: cannot encrypt ${root_target}" >&2
    exit 1
  }
  unset t3u_hash root_hash

  echo $"OK: wrote ${user_target} and ${root_target}"
  echo 'Next: just secret-rekey'
}
