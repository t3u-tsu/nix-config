#!/usr/bin/env ysh
#
# Hash the user password with yescrypt and encrypt it to the master secrets.
#
# Usage:
#   ysh scripts/secrets/set-host-password.ysh <hostname...|--all>
#

source $_this_dir/lib/bitwarden.ysh

agenix_bw_swap_guard $0 @[ARGV]

proc usage() {
  echo 'usage: ysh scripts/secrets/set-host-password.ysh <hostname...|--all>'
}

proc set_host_password(; args) {
  var targets = []
  var i = 0
  while (i < len(args)) {
    var arg = args[i]
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--all') {
        call targets->extend(agenix_bw_available_hosts())
      }
      (else) {
        if (arg.startsWith('-')) {
          log_error $"unknown option: ${arg}"
          exit 2
        }
        if (not agenix_bw_valid_hostname(arg)) {
          log_error $"invalid hostname: ${arg}"
          exit 2
        }
        call targets->append(arg)
      }
    }
    setvar i += 1
  }

  if (len(targets) === 0) {
    log_error 'no target host specified'
    usage >&2
    exit 2
  }

  agenix_bw_require 'mkpasswd'

  var password = ''
  var confirm = ''

  try { read -rsp $"password for ${DEFAULT_USER}: " password }
  if failed {
    log_die 'password input aborted'
  }
  echo '' >&2

  try { read -rsp 'confirm password: ' confirm }
  if failed {
    log_die 'password input aborted'
  }
  echo '' >&2

  if (password === '') {
    log_die 'empty password'
  }

  if (password !== confirm) {
    unset password confirm
    log_die 'passwords do not match'
  }
  unset confirm

  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = agenix_bw_primary_identity()
  if (recipient === '') {
    unset password
    log_die 'cannot derive the master recipient from the Bitwarden key'
  }

  var count = 0
  for host in (targets) {
    var host_hash = ''
    try { setvar host_hash = $(write --end '' -- $password | mkpasswd -m yescrypt -s) }
    if failed {
      unset password
      log_die 'mkpasswd failed to hash the password'
    }
    if (not host_hash.startsWith('$y$')) {
      unset password host_hash
      log_die $"mkpasswd returned no yescrypt hash for ${host}"
    }

    var host_dir = $"secrets/master/hosts/${host}"
    var user_target = $"${host_dir}/user_password_hash.age"
    mkdir -p $host_dir

    try { agenix_bw_encrypt_text (host_hash, user_target, recipient) }
    if failed {
      unset password host_hash
      log_die $"cannot encrypt ${user_target}"
    }
    unset host_hash
    log_ok $"wrote ${user_target} (host: ${host}, user: ${DEFAULT_USER})"
    setvar count += 1
  }

  unset password
  log_info $"updated ${count} host secret(s); next: just secret rekey"
}

if is-main {
  cd $_this_dir/../.. {
    set_host_password (ARGV)
  }
}
