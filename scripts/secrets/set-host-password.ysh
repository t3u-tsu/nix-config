#!/usr/bin/env ysh
#
# Generates a yescrypt hash and encrypts it to
# secrets/master/hosts/<hostname>/user_password_hash.age with the Bitwarden
# master identity.
#
# Usage:
#   ysh scripts/secrets/set-host-password.ysh [--user <name>] <hostname...>
#   ysh scripts/secrets/set-host-password.ysh [--user <name>] --all
#
# Multiple hosts can be specified at once: the password is read once with confirmation,
# but hashed independently for each host with unique yescrypt salts.

source $_this_dir/agenix-bw-lib.ysh

agenix_bw_swap_guard $0 @[ARGV]

const ALL_HOSTS = ['BrokenPC', 'kagutsuchi-sama', 'sando-kun', 'shosoin-tan', 'torii-chan', 'x1c7']

proc usage() {
  echo 'usage: ysh scripts/secrets/set-host-password.ysh [-u|--user <user>] <hostname...|--all>' >&2
}

func valid_name(name) {
  return (name ~ '^[A-Za-z0-9][A-Za-z0-9._-]*$')
}

var user = 't3u'
var targets = []
var i = 0

while (i < len(ARGV)) {
  var arg = ARGV[i]
  case (arg) {
    ('-h') { usage; exit 0 }
    ('--help') { usage; exit 0 }
    ('-u') {
      setvar i += 1
      if (i >= len(ARGV)) {
        echo 'ERROR: -u requires a username' >&2
        usage
        exit 2
      }
      setvar user = ARGV[i]
    }
    ('--user') {
      setvar i += 1
      if (i >= len(ARGV)) {
        echo 'ERROR: --user requires a username' >&2
        usage
        exit 2
      }
      setvar user = ARGV[i]
    }
    ('--all') {
      for h in (ALL_HOSTS) {
        call targets->append(h)
      }
    }
    (else) {
      if (arg.startsWith('-')) {
        echo $"ERROR: unknown option: ${arg}" >&2
        usage
        exit 2
      }
      if (not valid_name(arg)) {
        echo $"ERROR: invalid hostname: ${arg}" >&2
        exit 2
      }
      call targets->append(arg)
    }
  }
  setvar i += 1
}

if (not valid_name(user)) {
  echo $"ERROR: invalid username: ${user}" >&2
  exit 2
}

if (len(targets) === 0) {
  echo 'ERROR: no target host specified' >&2
  usage
  exit 2
}

shopt --unset verbose_errexit
agenix_bw_require 'mkpasswd'

var password = ''
var confirm = ''

try { read -rsp $"password for ${user}: " password }
if failed {
  echo 'ERROR: password input aborted.' >&2
  exit 1
}
echo

try { read -rsp 'confirm password: ' confirm }
if failed {
  echo 'ERROR: password input aborted.' >&2
  exit 1
}
echo

if (password === '') {
  echo 'ERROR: empty password' >&2
  exit 1
}

if (password !== confirm) {
  unset password confirm
  echo 'ERROR: passwords do not match' >&2
  exit 1
}
unset confirm

cd $_this_dir/../.. {
  agenix_bw_require 'bw'
  agenix_bw_require 'age'
  agenix_bw_require 'age-keygen'
  agenix_bw_session_init
  agenix_bw_fetch_identity
  agenix_bw_install_identity

  var recipient = agenix_bw_primary_identity()
  if (recipient === '') {
    unset password
    echo 'ERROR: cannot derive the master recipient from the Bitwarden key' >&2
    exit 1
  }

  var count = 0
  for host in (targets) {
    # Generate unique yescrypt salt and hash per host
    var host_hash = $(mkpasswd -m yescrypt -s <<< $password)
    if (not host_hash.startsWith('$y$')) {
      unset password host_hash
      echo $"ERROR: mkpasswd returned no yescrypt hash for ${host}" >&2
      exit 1
    }

    var host_dir = $"secrets/master/hosts/${host}"
    var user_target = $"${host_dir}/user_password_hash.age"
    mkdir -p $host_dir

    try { agenix_bw_encrypt_text (host_hash, user_target, recipient) }
    if failed {
      unset password host_hash
      echo $"ERROR: cannot encrypt ${user_target}" >&2
      exit 1
    }
    unset host_hash
    echo $"OK: wrote ${user_target} (host: ${host}, user: ${user})"
    setvar count += 1
  }

  unset password
  echo
  echo $"Updated ${count} host secret(s). Next: just secret-rekey"
}
