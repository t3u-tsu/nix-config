#!/usr/bin/env ysh
#
# Log in to Bitwarden or unlock the vault and hand the session to the in-memory agent.
#
# Usage:
#   ysh scripts/secrets/unlock.ysh [--raw | --env]
#
# --raw prints the session token; --env prints an eval-ready export line.

source $_this_dir/lib/bitwarden.ysh

agenix_bw_swap_guard $0 @[ARGV]

proc usage() {
  echo 'usage: ysh scripts/secrets/unlock.ysh [--raw | --env]'
}

proc unlock(; args) {
  var want_env = false
  var want_raw = false
  for arg in (args) {
    case (arg) {
      ('-h') { usage; return }
      ('--help') { usage; return }
      ('--env') { setvar want_env = true }
      ('--raw') { setvar want_raw = true }
      (else) {
        log_error $"unknown argument: ${arg}"
        exit 2
      }
    }
  }
  if (want_env and want_raw) {
    log_error '--env and --raw are mutually exclusive'
    exit 2
  }

  agenix_bw_session_init

  var quoted_session = agenix_bw_session.replace("'", "'\\''")
  var export_line = "export BW_SESSION='" ++ quoted_session ++ "'"
  if (want_env) {
    echo $export_line
    return
  }
  if (want_raw or not agenix_bw_is_tty(1)) {
    echo $agenix_bw_session
    return
  }
  log_ok 'Bitwarden vault unlocked (session held in-memory agent, auto-locks after 15m inactivity)'
  log_info 'Subsequent just secret commands reuse this session without export'
  log_info 'Optional for raw bw commands: export BW_SESSION=$(just secret unlock --raw)'
}

if is-main {
  cd $_this_dir/../.. {
    unlock (ARGV)
  }
}
