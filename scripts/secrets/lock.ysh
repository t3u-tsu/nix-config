#!/usr/bin/env ysh
#
# Lock Bitwarden and purge the in-memory session agent.
#
# Usage:
#   ysh scripts/secrets/lock.ysh
#

source $_this_dir/lib/bitwarden.ysh

agenix_bw_swap_guard $0 @[ARGV]

proc usage() {
  echo 'usage: ysh scripts/secrets/lock.ysh'
}

proc lock(; args) {
  if (len(args) > 0) {
    usage
    exit 2
  }
  agenix_bw_clear_cached_session
  log_ok 'Bitwarden vault locked and agent memory purged'
}

cd $_this_dir/../.. {
  lock (ARGV)
}
