#!/usr/bin/env ysh
#
# Decrypt a master secret into the noswap tmpfs, open it in $EDITOR, and wipe it on exit.
#
# Usage:
#   ysh scripts/secrets/edit.ysh <file>
#

source $_this_dir/lib/bitwarden.ysh

agenix_bw_swap_guard $0 @[ARGV]

proc usage() {
  echo 'usage: ysh scripts/secrets/edit.ysh <file>'
}

if (len(ARGV) !== 1) {
  usage
  exit 2
}
var file = ARGV[0]
shopt --unset verbose_errexit
cd $_this_dir/../.. {
  if (not agenix_bw_file_exists(file)) {
    agenix_bw_die $"secret file not found: ${file}"
  }
  # Keep cleartext edit scratch files inside the noswap tmpfs.
  agenix_bw_run_with_agenix (['edit', file]; key_dir_tmpdir=true)
}
