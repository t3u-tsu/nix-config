# Vesper palette (Noctalia community "Vesper"). Shared by the home and system
# modules; each consumer converts these hex strings to its own notation
# (alpha, lowercase, non-# hex).
{
  bg = "#0c0c0c";
  bg2 = "#1c1c1c";
  bg3 = "#262626";
  card = "#141414";
  dim = "#5e5e5e";
  low = "#505050";
  fg = "#ffffff";
  fg2 = "#a0a0a0";
  primary = "#ffc799";
  secondary = "#99ffe4";
  tertiary = "#fbadff";
  err = "#ff8080";
  link = "#80b3ff";

  # Material roles without a counterpart above; the greeter needs the complete
  # Vesper set, and the "on_*" contrast partners are all black.
  on_primary = "#000000";
  on_secondary = "#000000";
  on_tertiary = "#000000";
  on_error = "#000000";
  hover = "#282828";
  on_hover = "#ffffff";
  shadow = "#000000";
}
